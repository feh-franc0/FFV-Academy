#!/bin/sh
# Pre-commit hook — roda lint e testes antes de cada commit.
# Se qualquer etapa falhar, o commit é cancelado.
# Para pular em emergência: git commit --no-verify (use com consciência)

echo "→ Verificando frontend..."
cd "$(git rev-parse --show-toplevel)/frontend"

# ESLint nos arquivos staged (não roda em todos — só nos alterados)
echo "  lint..."
npx eslint src/ --ext .ts,.tsx 2>&1 || exit 1

# Testes rápidos (unit + integration — sem E2E)
echo "  testes..."
npm test 2>&1 || exit 1

echo "→ Verificando backend..."
cd "$(git rev-parse --show-toplevel)/backend"
go build ./... 2>&1 || exit 1
go test ./... 2>&1 || exit 1

echo "✓ Tudo ok — commit liberado."
