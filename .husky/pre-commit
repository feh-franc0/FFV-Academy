#!/bin/sh
# Pre-commit hook — roda lint e testes antes de cada commit.
# Se qualquer etapa falhar, o commit é cancelado.
# Para pular em emergência: git commit --no-verify (use com consciência)

# Cacha o toplevel uma vez para evitar problemas em worktrees onde
# chamadas subsequentes a `git rev-parse --show-toplevel` após `cd`
# podem retornar o caminho errado.
TOPLEVEL="$(git rev-parse --show-toplevel)"

if [ -d "$TOPLEVEL/frontend" ]; then
  echo "→ Verificando frontend..."
  cd "$TOPLEVEL/frontend" || exit 1

  echo "  lint..."
  npx eslint src/ --ext .ts,.tsx 2>&1 || exit 1

  echo "  testes..."
  npm test 2>&1 || exit 1
else
  echo "→ Pulando frontend (diretório não existe neste worktree)."
fi

if [ -d "$TOPLEVEL/backend" ]; then
  echo "→ Verificando backend..."
  cd "$TOPLEVEL/backend" || exit 1
  go build ./... 2>&1 || exit 1
  go test ./... 2>&1 || exit 1
else
  echo "→ Pulando backend (diretório não existe neste worktree)."
fi

echo "✓ Tudo ok — commit liberado."
