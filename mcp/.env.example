# URL base da API FFV Academy.
# Local: http://localhost:8080  |  Produção: https://api.fernandofrancovalle.com
FFV_API_BASE_URL=http://localhost:8080

# JWT de admin (role=admin) usado para tools de mutação (create/update/delete).
# Sem token, apenas tools de leitura funcionam (catálogo é público).
# Em dev, gere via fluxo magic-link (auth/request-token + auth/verify) com email admin.
FFV_ADMIN_TOKEN=

# Timeout por request HTTP em ms (default 15000).
FFV_HTTP_TIMEOUT_MS=15000
