# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Claude Code agent worktrees — criados temporariamente durante sessões de agentes
.claude/worktrees/
.claude/scheduled_tasks.lock

# misc
.DS_Store
**/.DS_Store
*.pem

# chaves e certificados — achado P-17 (auditoria de 11/ago/2026): a raiz só
# cobria *.pem; chave/certificado em outro formato fora de backend/ não tinha
# proteção nenhuma.
*.key
*.crt
*.pfx
id_rsa*
id_ed25519*

# env files — arquivos reais com segredos
.env
.env.local
.env.*.local
.env.*
# mas os templates de exemplo SÃO commitados (negação tem de vir DEPOIS de
# qualquer padrão .env.* acima — regra do gitignore é "a última que casa
# vence", e uma negação antes de um padrão mais amplo seria sobrescrita)
!**/.env.example
!**/.env.local.example

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# python
__pycache__/
*.pyc

# IDE
.vscode/
.idea/
**/.amazonq/

# excel temp files
~$*

# drawio temp files
*.dtmp

# typescript build info (generated)
*.tsbuildinfo

# ----- frontend (Next.js) -----
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/hostinger/
frontend/ffv-academy-hostinger.zip
frontend/coverage/
frontend/.pnp
frontend/.pnp.*
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions
frontend/next-env.d.ts
frontend/build/

# ----- video-pipeline (Remotion + Playwright) -----
video-pipeline/node_modules/
video-pipeline/out/
video-pipeline/assets/screenshots/
video-pipeline/public/screenshots/
video-pipeline/public/beats/hero/
video-pipeline/public/beats/hero-computer/
video-pipeline/public/beats/hero-phone/

# ----- backend (Go) -----
backend/tmp/
backend/.env

# ----- legacy root artifacts (pre-monorepo) -----
/node_modules
/out/
/hostinger
/ffv-academy-hostinger.zip
/.next/
/coverage
/build
backend/importer

# Cache do gerador de corpus de busca (scripts/seo)
scripts/seo/.dados/
