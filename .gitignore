# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# misc
.DS_Store
**/.DS_Store
*.pem

# env files — arquivos reais com segredos
.env
.env.local
.env.*.local
# mas os templates de exemplo SÃO commitados
!**/.env.example
!**/.env.local.example

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# python
__pycache__/
*.pyc

# IDE
.vscode/
.idea/

# excel temp files
~$*

# drawio temp files
*.dtmp

# typescript build info (generated)
*.tsbuildinfo

