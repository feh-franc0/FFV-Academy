# =============================================================================
# FFV Academy Frontend — template de variáveis de ambiente
# Copie para .env.local e preencha os valores.
# =============================================================================

# URL base da API Go (sem barra no final).
# Deixe vazio para usar o modo mock (sem backend rodando).
# Dev com backend local: http://localhost:8080
# Prod:                  https://api.fernandofrancovalle.com
NEXT_PUBLIC_API_BASE_URL=

# DSN do Sentry para captura de exceções em produção.
# Deixe vazio para desabilitar Sentry (padrão em dev/local).
# Obtenha em: https://sentry.io → Project Settings → Client Keys
NEXT_PUBLIC_SENTRY_DSN=

# =============================================================================
# Feature flags — defina "true" para habilitar quando a integração estiver pronta.
# Backend tem equivalentes (FEATURE_BILLING_ENABLED etc) — mantenha em sincronia.
# =============================================================================
NEXT_PUBLIC_FEATURE_BILLING_ENABLED=false
NEXT_PUBLIC_FEATURE_TUTOR_AI_ENABLED=false
NEXT_PUBLIC_FEATURE_PHONE_AUTH_ENABLED=false
