{
  "name": "ffv-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/ --ext .ts,.tsx && node scripts/check-hex-in-style.mjs",
    "lint:ci": "eslint src/ --ext .ts,.tsx --max-warnings=0 && node scripts/check-hex-in-style.mjs",
    "check:hex-style": "node scripts/check-hex-in-style.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:ci": "playwright test --reporter=html",
    "generate-icons": "node scripts/generate-icons.mjs",
    "bundlesize:check": "npx bundlesize",
    "bundle:check": "node scripts/check-route-bundle.mjs",
    "check:no-code-execution-cdns": "node scripts/check-no-code-execution-cdns.mjs",
    "prepare": "cd .. && git config core.hooksPath .husky || true",
    "varredura": "playwright test -c playwright.varredura.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@sentry/nextjs": "^10.50.0",
    "@types/dompurify": "^3.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.13",
    "idb": "^8.0.3",
    "lucide-react": "^1.8.0",
    "lz-string": "^1.5.0",
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "shiki": "^4.0.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.5",
    "axe-core": "^4.10.2",
    "eslint": "^10",
    "eslint-config-next": "16.3.0",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.4.0",
    "satori": "^0.26.0",
    "shadcn": "^4.2.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
