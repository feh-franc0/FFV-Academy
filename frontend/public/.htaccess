# Apache/LiteSpeed rewrite config para Next.js static export na Hostinger.
#
# Sem este arquivo, /aprenda/<slug>/ e qualquer outra rota subdiretório
# retornam 403 porque o servidor não sabe que precisa servir o index.html
# de dentro da pasta. /admin retorna 404 pela mesma razão.
#
# trailingSlash: true no next.config gera out/<rota>/index.html — este
# rewrite garante que requests pra /admin/, /aprenda/o-que-e-ia/, etc
# resolvam pro index.html correspondente.

Options -Indexes

# Charset default UTF-8 — evita acentos quebrados em conteúdo PT-BR.
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Se já existe arquivo ou diretório, serve direto.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback final pro index.html da raiz (404 customizado vem antes).
  RewriteRule ^ index.html [L]
</IfModule>

# Cache long-lived para assets imutáveis do Next.js (hash no nome).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/jpg  "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css   "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# Compressão Gzip pra reduzir banda em HTML/CSS/JS.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml
</IfModule>

# Páginas de erro custom (404 ainda servido pelo Next se existir).
ErrorDocument 404 /404.html
