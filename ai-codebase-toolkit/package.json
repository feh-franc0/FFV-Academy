{
  "name": "ai-codebase-toolkit",
  "displayName": "AI Codebase Toolkit",
  "description": "Prepare your codebase for AI. Generate instructions, specs (SDD), test suites, architecture diagrams and scaffolds \u2014 works with Claude Code, Amazon Q, Copilot, Cursor and any MCP client.",
  "version": "0.1.0",
  "publisher": "feh-franc0",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/feh-franc0/ai-codebase-toolkit"
  },
  "homepage": "https://github.com/feh-franc0/ai-codebase-toolkit#readme",
  "bugs": {
    "url": "https://github.com/feh-franc0/ai-codebase-toolkit/issues"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=18.0.0"
  },
  "categories": [
    "AI",
    "Other",
    "Snippets",
    "Linters"
  ],
  "keywords": [
    "ai",
    "claude",
    "amazon q",
    "copilot",
    "cursor",
    "sdd",
    "mermaid",
    "scaffold",
    "context",
    "mcp"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:package.json",
    "workspaceContains:pyproject.toml",
    "workspaceContains:requirements.txt",
    "workspaceContains:go.mod",
    "workspaceContains:Cargo.toml",
    "workspaceContains:CLAUDE.md"
  ],
  "contributes": {
    "commands": [
      {
        "command": "aiToolkit.scanProject",
        "title": "AI Toolkit: Scan Project",
        "category": "AI Toolkit"
      },
      {
        "command": "aiToolkit.generateInstructions",
        "title": "AI Toolkit: Generate AI Instructions",
        "category": "AI Toolkit"
      },
      {
        "command": "aiToolkit.scaffoldFeature",
        "title": "AI Toolkit: Scaffold Feature",
        "category": "AI Toolkit"
      },
      {
        "command": "aiToolkit.generateAdr",
        "title": "AI Toolkit: New ADR",
        "category": "AI Toolkit"
      },
      {
        "command": "aiToolkit.generateSdd",
        "title": "AI Toolkit: New SDD Spec",
        "category": "AI Toolkit"
      },
      {
        "command": "aiToolkit.generateTestSuite",
        "title": "AI Toolkit: Generate Test Suite",
        "category": "AI Toolkit"
      },
      {
        "command": "aiToolkit.generateArchitectureDiagram",
        "title": "AI Toolkit: Generate Architecture Diagram",
        "category": "AI Toolkit"
      },
      {
        "command": "aiToolkit.generateDocsSite",
        "title": "AI Toolkit: Generate Documentation Site",
        "category": "AI Toolkit"
      },
      {
        "command": "aiToolkit.showReadinessScore",
        "title": "AI Toolkit: Show AI-Readiness Score",
        "category": "AI Toolkit"
      },
      {
        "command": "aiToolkit.checkDrift",
        "title": "AI Toolkit: Check Drift in AI Instructions",
        "category": "AI Toolkit"
      },
      {
        "command": "aiToolkit.enrichWithAI",
        "title": "AI Toolkit: Enrich with IDE AI",
        "category": "AI Toolkit"
      },
      {
        "command": "aiToolkit.generateOnboarding",
        "title": "AI Toolkit: Generate Onboarding Guide",
        "category": "AI Toolkit"
      },
      {
        "command": "aiToolkit.generatePRContext",
        "title": "AI Toolkit: Generate PR Context",
        "category": "AI Toolkit"
      },
      {
        "command": "aiToolkit.detectDocGaps",
        "title": "AI Toolkit: Detect Documentation Gaps",
        "category": "AI Toolkit"
      },
      {
        "command": "aiToolkit.showMetrics",
        "title": "AI Toolkit: Quality Metrics",
        "category": "AI Toolkit"
      },
      {
        "command": "aiToolkit.editOverrides",
        "title": "AI Toolkit: Edit Overrides",
        "category": "AI Toolkit"
      },
      {
        "command": "aiToolkit.compareWithAI",
        "title": "AI Toolkit: Compare AI Responses",
        "category": "AI Toolkit"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "aiToolkit.scaffoldFeature",
          "when": "explorerResourceIsFolder",
          "group": "aiToolkit@1"
        },
        {
          "command": "aiToolkit.generateTestSuite",
          "when": "resourceLangId =~ /typescript|javascript|python|go|java/",
          "group": "aiToolkit@2"
        }
      ],
      "view/title": [
        {
          "command": "aiToolkit.scanProject",
          "when": "view == aiToolkit.toolsView",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiToolkit",
          "title": "AI Toolkit",
          "icon": "$(rocket)"
        }
      ]
    },
    "views": {
      "aiToolkit": [
        {
          "id": "aiToolkit.toolsView",
          "name": "Tools",
          "icon": "$(tools)"
        },
        {
          "id": "aiToolkit.scoreView",
          "name": "Score",
          "icon": "$(graph)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "aiToolkit.toolsView",
        "contents": "Open a folder to start using AI Toolkit.\n[Open Folder](command:vscode.openFolder)\nAlready in a project?\n[Scan Project](command:aiToolkit.scanProject)\n[Generate AI Instructions](command:aiToolkit.generateInstructions)\n\nLearn more: [Getting Started](command:workbench.action.openWalkthrough?%22feh-franc0.ai-codebase-toolkit%23aiToolkit.gettingStarted%22)"
      }
    ],
    "walkthroughs": [
      {
        "id": "aiToolkit.gettingStarted",
        "title": "Get started with AI Codebase Toolkit",
        "description": "Prepare your codebase so the AI you already use understands it.",
        "steps": [
          {
            "id": "instructions",
            "title": "Step 1 \u2014 Generate AI instructions",
            "description": "One command creates CLAUDE.md, .cursorrules, copilot-instructions, .amazonq rules and AGENTS.md from your real project. Every AI you use will read them automatically.\n[Generate Instructions](command:aiToolkit.generateInstructions)",
            "media": {
              "markdown": "media/walkthrough/instructions.md"
            },
            "completionEvents": [
              "onCommand:aiToolkit.generateInstructions"
            ]
          },
          {
            "id": "score",
            "title": "Step 2 \u2014 Check your AI-Readiness score",
            "description": "A 0\u2013100 score that shows how prepared your codebase is for AI. Each missing point comes with a one-click fix.\n[Show Score](command:aiToolkit.showReadinessScore)",
            "media": {
              "markdown": "media/walkthrough/scan.md"
            },
            "completionEvents": [
              "onCommand:aiToolkit.showReadinessScore"
            ]
          },
          {
            "id": "drift",
            "title": "Step 3 \u2014 Drift detection (the killer feature)",
            "description": "Your AI files will go stale as your project evolves. The toolkit watches for changes and warns you when CLAUDE.md / .cursorrules / etc. fall out of sync.\n[Check Drift](command:aiToolkit.checkDrift)",
            "media": {
              "markdown": "media/walkthrough/drift.md"
            },
            "completionEvents": [
              "onCommand:aiToolkit.checkDrift"
            ]
          },
          {
            "id": "extras",
            "title": "Optional \u2014 Specs, tests, diagrams",
            "description": "Extras that build on the core: SDD specs, multi-layer test suites, Mermaid architecture diagrams, scaffold features, and a runnable docs site.\n[Browse the toolkit](command:workbench.view.extension.aiToolkit)",
            "media": {
              "markdown": "media/walkthrough/sdd.md"
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "AI Codebase Toolkit",
      "properties": {
        "aiToolkit.targets.claude": {
          "type": "boolean",
          "default": true,
          "description": "Generate CLAUDE.md for Claude Code."
        },
        "aiToolkit.targets.cursor": {
          "type": "boolean",
          "default": true,
          "description": "Generate .cursorrules for Cursor."
        },
        "aiToolkit.targets.copilot": {
          "type": "boolean",
          "default": true,
          "description": "Generate .github/copilot-instructions.md."
        },
        "aiToolkit.targets.amazonq": {
          "type": "boolean",
          "default": true,
          "description": "Generate .amazonq/rules/project.md."
        },
        "aiToolkit.targets.agents": {
          "type": "boolean",
          "default": true,
          "description": "Generate AGENTS.md (Cline, Continue, Aider, etc.)."
        },
        "aiToolkit.autoSync": {
          "type": "boolean",
          "default": false,
          "description": "Watch the workspace and warn when AI instruction files are stale."
        },
        "aiToolkit.sdd.docsFolder": {
          "type": "string",
          "default": "docs/specs",
          "description": "Folder where SDD specs are stored."
        },
        "aiToolkit.adr.docsFolder": {
          "type": "string",
          "default": "docs/adr",
          "description": "Folder where ADRs are stored."
        },
        "aiToolkit.diagrams.folder": {
          "type": "string",
          "default": "docs/architecture",
          "description": "Folder where Mermaid diagrams are stored."
        },
        "aiToolkit.sampling.maxFiles": {
          "type": "number",
          "default": 8,
          "description": "Maximum number of files sampled for AI analysis."
        },
        "aiToolkit.sampling.maxTotalBytes": {
          "type": "number",
          "default": 32768,
          "description": "Maximum total bytes across all sampled files."
        },
        "aiToolkit.sampling.maxFileBytes": {
          "type": "number",
          "default": 6144,
          "description": "Maximum bytes per sampled file (content is truncated at this limit)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:ui": "vitest",
    "test:coverage": "vitest run --coverage",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "@vscode/vsce": "^3.9.1",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
