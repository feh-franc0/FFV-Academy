{
  "name": "ffv-academy-marketing",
  "version": "1.0.0",
  "private": true,
  "description": "Pipeline de video promocional FFV Academy (Puppeteer + Remotion)",
  "scripts": {
    "video": "bash scripts/one-click.sh",
    "capture": "npx tsx scripts/capture.ts",
    "preview": "npx remotion preview src/index.tsx",
    "render": "npx remotion render src/index.tsx PromoVideo out/promo.mp4 --codec h264 --crf 18",
    "thumbnail": "npx remotion still src/index.tsx PromoVideo out/thumbnail.png --frame 720",
    "extract-frames": "bash scripts/extract-frames.sh",
    "validate": "npx tsx scripts/validate-cli.ts",
    "pipeline": "npx tsx scripts/build-all.ts",
    "build": "npm run video"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "lz-string": "^1.5.0",
    "puppeteer": "^24.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
