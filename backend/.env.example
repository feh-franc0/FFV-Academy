# =============================================================================
# FFV Academy API — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env com segredos reais.
# =============================================================================

# ─── App ─────────────────────────────────────────────────────────────────────
# APP_ENV é OBRIGATÓRIO. Se deixar vazio, o código assume "development" e:
#   - Usa MailHog (localhost:1025) em vez do Resend → emails NÃO saem em prod
#   - Habilita o bypass "000000" no magic link → qualquer um loga como qualquer email
# Em prod SEMPRE setar APP_ENV=production explicitamente.
APP_ENV=                        # development | production | test  (REQUIRED em prod)
APP_NAME=ffv-api
APP_VERSION=dev

# ─── HTTP ─────────────────────────────────────────────────────────────────────
HTTP_PORT=8080                  # porta que o servidor escuta
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_SHUTDOWN_TIMEOUT=30s

# ─── Database (PostgreSQL 16) ─────────────────────────────────────────────────
# Formato: postgres://USUARIO:SENHA@HOST:PORTA/BANCO?sslmode=disable
DATABASE_URL=
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# ─── Redis 7 ─────────────────────────────────────────────────────────────────
# Formato: redis://HOST:PORTA/DB_INDEX
REDIS_URL=
REDIS_PASSWORD=                 # vazio se sem senha

# ─── JWT (HS256) ─────────────────────────────────────────────────────────────
# JWT_SECRET: string aleatória com pelo menos 32 caracteres
# Gere com: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL=15m              # tempo de vida do access token
JWT_REFRESH_TTL=720h            # tempo de vida do refresh token (30 dias)
JWT_ISSUER=ffv-api
JWT_AUDIENCE=ffv-frontend

# ─── Stripe ──────────────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY: chave secreta da conta Stripe (sk_live_... em prod, sk_test_... em dev)
# Painel: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET: segredo do webhook Stripe (whsec_...)
# Painel: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=
# STRIPE_SIMULADO_PRICE_ID: ID do Price do simulado no Stripe (price_...)
# Painel: https://dashboard.stripe.com/products
STRIPE_SIMULADO_PRICE_ID=
STRIPE_SUCCESS_URL=             # URL do frontend após pagamento aprovado
STRIPE_CANCEL_URL=              # URL do frontend após pagamento cancelado

# ─── Resend (Email) ──────────────────────────────────────────────────────────
# RESEND_API_KEY: chave da API Resend (re_...)
# Painel: https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=              # ex: noreply@seudominio.com (deve estar verificado no Resend)
RESEND_FROM_NAME=               # ex: FFV Academy

# ─── Twilio (SMS) ────────────────────────────────────────────────────────────
# TWILIO_ACCOUNT_SID: SID da conta Twilio (AC...)
# TWILIO_AUTH_TOKEN: token de autenticação Twilio
# Painel: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER: número Twilio em formato E.164 (+5511...)
TWILIO_FROM_NUMBER=

# ─── Anthropic (Claude AI) ───────────────────────────────────────────────────
# ANTHROPIC_API_KEY: chave da API Anthropic (sk-ant-...)
# Painel: https://console.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=1024
ANTHROPIC_CACHE_TTL=168h        # cache de resposta do tutor (7 dias)
ANTHROPIC_RATE_LIMIT_FREE=50    # perguntas/hora para usuários free
ANTHROPIC_RATE_LIMIT_PRO=200    # perguntas/hora para usuários pagos

# ─── CORS ────────────────────────────────────────────────────────────────────
# Origens permitidas — separadas por VÍRGULA (sem espaço extra).
# Dev:  http://localhost:3000
# Prod: incluir tanto a canônica (sem www) quanto o www, porque o browser
#       pode disparar preflight do origin original do bookmark antes do
#       Nginx redirecionar 301 www → sem-www.
# Prod: https://fernandofrancovalle.com,https://www.fernandofrancovalle.com
CORS_ALLOWED_ORIGINS=

# FRONTEND_URL: URL raiz do frontend (para redirects pós-auth)
# Dev:  http://localhost:3000
# Prod: https://fernandofrancovalle.com
FRONTEND_URL=

# ─── Admin allowlist (DEFESA EM PROFUNDIDADE) ────────────────────────────────
# Lista de emails permitidos pra acessar /api/v1/admin/* — separados por
# VÍRGULA, sem espaço extra. Middleware exige role='admin' no DB AND email
# nesta lista. Falhar qualquer uma das duas devolve 403.
#
# Vazio = só role check (modo dev/test, NÃO usar em produção).
# Prod: ADMIN_EMAIL_ALLOWLIST=fernandofv1110@gmail.com
ADMIN_EMAIL_ALLOWLIST=

# ─── Storage de anexos (StudyRequest uploads) ────────────────────────────────
# Provider DEFAULT em produção: Cloudflare R2 (S3-compatible, zero egress).
# Se S3_BUCKET é setado, usa S3-compatible. Caso contrário, usa disco local
# em UPLOAD_DIR (apenas dev/fallback de emergência).

# ─── Cloudflare R2 (produção) ────────────────────────────────────────────────
# Setup: Cloudflare Dashboard → R2 → Create bucket "ffv-uploads"
#        → Manage R2 API Tokens → Create API token (Object Read & Write)
# Account ID: canto direito do dashboard R2
#
# Endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Região "auto" é o padrão do R2 (não tem regiões nominais como AWS).
S3_BUCKET=ffv-uploads
S3_ENDPOINT=https://CHANGE_ME_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PATH_STYLE=false

# ─── UPLOAD_DIR (fallback local — só se S3_BUCKET estiver vazio) ─────────────
# Dev:  /tmp/ffv-uploads (default se vazio)
# Prod: /opt/ffv/uploads (volume Docker montado) — NÃO usar em produção
UPLOAD_DIR=

# ─── Alternativas a R2 (caso queira trocar de provider) ──────────────────────
# Backblaze B2:
#   S3_ENDPOINT=https://s3.<region>.backblazeb2.com (ex: us-west-001)
#   S3_REGION=us-west-001
#   S3_PATH_STYLE=false
# MinIO (self-hosted / dev local):
#   S3_ENDPOINT=http://localhost:9000
#   S3_REGION=us-east-1
#   S3_PATH_STYLE=true
# AWS S3:
#   S3_ENDPOINT=                  (vazio = SDK default)
#   S3_REGION=us-east-1
#   S3_PATH_STYLE=false
