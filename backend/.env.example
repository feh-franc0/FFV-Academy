# =============================================================================
# FFV Academy API — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env com segredos reais.
# =============================================================================

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=                        # development | production | test
APP_NAME=ffv-api
APP_VERSION=dev

# ─── HTTP ─────────────────────────────────────────────────────────────────────
HTTP_PORT=8080                  # porta que o servidor escuta
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_SHUTDOWN_TIMEOUT=30s

# ─── Database (PostgreSQL 16) ─────────────────────────────────────────────────
# Formato: postgres://USUARIO:SENHA@HOST:PORTA/BANCO?sslmode=disable
DATABASE_URL=
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# ─── Redis 7 ─────────────────────────────────────────────────────────────────
# Formato: redis://HOST:PORTA/DB_INDEX
REDIS_URL=
REDIS_PASSWORD=                 # vazio se sem senha

# ─── JWT (HS256) ─────────────────────────────────────────────────────────────
# JWT_SECRET: string aleatória com pelo menos 32 caracteres
# Gere com: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL=15m              # tempo de vida do access token
JWT_REFRESH_TTL=720h            # tempo de vida do refresh token (30 dias)
JWT_ISSUER=ffv-api
JWT_AUDIENCE=ffv-frontend

# ─── Stripe ──────────────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY: chave secreta da conta Stripe (sk_live_... em prod, sk_test_... em dev)
# Painel: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET: segredo do webhook Stripe (whsec_...)
# Painel: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=
# STRIPE_SIMULADO_PRICE_ID: ID do Price do simulado no Stripe (price_...)
# Painel: https://dashboard.stripe.com/products
STRIPE_SIMULADO_PRICE_ID=
STRIPE_SUCCESS_URL=             # URL do frontend após pagamento aprovado
STRIPE_CANCEL_URL=              # URL do frontend após pagamento cancelado

# ─── Resend (Email) ──────────────────────────────────────────────────────────
# RESEND_API_KEY: chave da API Resend (re_...)
# Painel: https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=              # ex: noreply@seudominio.com (deve estar verificado no Resend)
RESEND_FROM_NAME=               # ex: FFV Academy

# ─── Twilio (SMS) ────────────────────────────────────────────────────────────
# TWILIO_ACCOUNT_SID: SID da conta Twilio (AC...)
# TWILIO_AUTH_TOKEN: token de autenticação Twilio
# Painel: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER: número Twilio em formato E.164 (+5511...)
TWILIO_FROM_NUMBER=

# ─── Anthropic (Claude AI) ───────────────────────────────────────────────────
# ANTHROPIC_API_KEY: chave da API Anthropic (sk-ant-...)
# Painel: https://console.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=1024
ANTHROPIC_CACHE_TTL=168h        # cache de resposta do tutor (7 dias)
ANTHROPIC_RATE_LIMIT_FREE=50    # perguntas/hora para usuários free
ANTHROPIC_RATE_LIMIT_PRO=200    # perguntas/hora para usuários pagos

# ─── CORS ────────────────────────────────────────────────────────────────────
# Origens permitidas separadas por espaço
# Dev: http://localhost:3000
# Prod: https://fernandofrancovalle.com
CORS_ALLOWED_ORIGINS=

# ─── Google OAuth 2.0 (opcional — deixe vazio para desabilitar) ──────────────
# Crie as credenciais em: https://console.cloud.google.com/apis/credentials
#   Tipo: "Web application"
#   Authorized redirect URIs: valor de GOOGLE_REDIRECT_URL abaixo
# GOOGLE_CLIENT_ID: termina em .apps.googleusercontent.com
GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET: string secreta gerada pelo Google Console
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL: deve coincidir exatamente com o URI cadastrado no Google Console
# Dev:  http://localhost:8080/api/v1/auth/google/callback
# Prod: https://api.fernandofrancovalle.com/api/v1/auth/google/callback
GOOGLE_REDIRECT_URL=
# FRONTEND_URL: URL raiz do frontend (para redirect após callback do Google)
# Dev:  http://localhost:3000
# Prod: https://fernandofrancovalle.com
FRONTEND_URL=
