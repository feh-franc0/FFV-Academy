erDiagram

  %% ─── IDENTIDADE ──────────────────────────────────────────
  users {
    TEXT id PK
    TEXT email UK
    TEXT phone
    TEXT name
    TEXT role
    TEXT referral_id UK
    BOOL marketing_consent
    TIMESTAMPTZ deleted_at
  }

  refresh_tokens {
    TEXT id PK
    TEXT user_id FK
    TEXT token_hash UK
    TIMESTAMPTZ expires_at
    TIMESTAMPTZ revoked_at
  }

  user_preferences {
    TEXT user_id PK
    TEXT hub_ids
    TEXT trail_ids
    TEXT certification_ids
    TEXT objectives
    TEXT skill_level
    BOOL daily_question_enabled
    TIMESTAMPTZ onboarded_at
  }

  leaderboard_opt_ins {
    TEXT user_id PK
  }

  %% ─── CURRÍCULO (hierarquia via FK) ───────────────────────
  bases {
    TEXT slug PK
    TEXT name
    TEXT status
    TEXT url
    JSONB theme
    JSONB nav_items
    JSONB footer
    BOOL hide_global_content_nav
    INT sort_order
  }

  hubs {
    TEXT id PK
    TEXT base_slug FK
    TEXT slug
    TEXT name
    TEXT short_name
    TEXT icon
    TEXT color
    INT position
  }

  trails {
    TEXT id PK
    TEXT hub_id FK
    TEXT slug
    TEXT name
    TEXT difficulty
    TEXT status
    TEXT level
    INT position
  }

  curriculum_articles {
    UUID id PK
    TEXT slug UK
    TEXT trail_id FK
    TEXT hub_id FK
    TEXT title
    INT xp
    INT read_time
    TEXT difficulty
    TEXT status
    INT order
    TIMESTAMPTZ deleted_at
  }

  module_blocks {
    UUID id PK
    TEXT article_slug FK
    UUID parent_id FK
    INT position
    TEXT block_type
    JSONB block_data
  }

  module_quizzes {
    UUID id PK
    TEXT module_slug FK
    INT position
    TEXT stem
    JSONB options
    TEXT correct_id
    TEXT explanation
    TEXT difficulty
  }

  module_prerequisites {
    TEXT module_slug PK
    TEXT prerequisite_slug PK
  }

  module_next_suggested {
    TEXT module_slug PK
    TEXT next_slug PK
    INT position
  }

  %% ─── PROGRESSO / GAMIFICAÇÃO ─────────────────────────────
  progress_snapshots {
    TEXT user_id PK
    INT schema_version
    JSONB state
    TIMESTAMPTZ client_updated_at
    TIMESTAMPTZ server_updated_at
  }

  leaderboard {
    TEXT user_id PK
    DATE week_start PK
    INT xp_gained
  }

  trail_enrollments {
    TEXT user_id PK
    TEXT trail_id PK
    TEXT last_seen_slug FK
    TIMESTAMPTZ started_at
    TIMESTAMPTZ completed_at
  }

  article_bookmarks {
    TEXT user_id PK
    TEXT article_slug PK
  }

  article_ratings {
    TEXT user_id PK
    TEXT article_slug PK
    SMALLINT rating
    TEXT feedback
  }

  module_views {
    BIGSERIAL id PK
    TEXT user_id
    TEXT anon_id
    TEXT slug
    TEXT hub_id
    TEXT trail_id
    INT duration_sec
    TIMESTAMPTZ viewed_at
  }

  module_quiz_attempts {
    UUID id PK
    TEXT user_id FK
    UUID quiz_id FK
    NUMERIC ease_factor
    INT interval_days
    INT repetitions
    BOOL last_answer_correct
    TIMESTAMPTZ next_review_at
  }

  %% ─── SIMULADOS ───────────────────────────────────────────
  simulados {
    TEXT id PK
    TEXT base_slug FK
    TEXT certification
    TEXT title
    INT price_cents
    INT question_count
    INT time_limit_min
    INT passing_score
    TEXT status
  }

  questions {
    TEXT id PK
    TEXT simulado_id FK
    TEXT related_module_slug FK
    TEXT stem
    JSONB options
    TEXT correct_id
    TEXT topic
    TEXT domain
    TEXT difficulty
    TEXT status
  }

  simulado_attempts {
    TEXT id PK
    TEXT user_id FK
    TEXT simulado_id FK
    TEXT status
    JSONB answers
    JSONB score
    TIMESTAMPTZ deadline
    TIMESTAMPTZ finished_at
  }

  certificates {
    TEXT hash PK
    TEXT user_id FK
    TEXT simulado_id
    TEXT attempt_id FK
    TEXT holder_name
    TIMESTAMPTZ issued_at
  }

  question_reports {
    TEXT id PK
    TEXT user_id FK
    TEXT simulado_id
    TEXT question_id
    TEXT reason
    TIMESTAMPTZ resolved_at
  }

  %% ─── COMERCIAL ───────────────────────────────────────────
  purchases {
    TEXT id PK
    TEXT user_id FK
    TEXT product_id
    TEXT stripe_session_id UK
    BIGINT amount_cents
    TEXT status
  }

  user_products {
    TEXT user_id PK
    TEXT product_id PK
    TEXT purchase_id
    TIMESTAMPTZ granted_at
  }

  %% ─── SOCIAL / COMUNIDADE ─────────────────────────────────
  comments {
    UUID id PK
    TEXT user_id FK
    TEXT target_type
    TEXT target_id
    UUID parent_id FK
    TEXT content
    TEXT status
  }

  referrals {
    TEXT id PK
    TEXT referrer_id FK
    TEXT referred_id FK
  }

  %% ─── PLATAFORMA ──────────────────────────────────────────
  study_requests {
    TEXT id PK
    TEXT user_id FK
    TEXT email
    TEXT study_area
    TEXT subject
    TEXT status
  }

  study_request_attachments {
    TEXT id PK
    TEXT study_request_id FK
    TEXT file_name
    TEXT storage_url
    BIGINT size_bytes
  }

  user_events {
    BIGSERIAL id PK
    TEXT event_type
    TEXT user_id
    TEXT anon_id
    TEXT base_slug
    TEXT path
    JSONB metadata
    TIMESTAMPTZ occurred_at
  }

  audit_logs {
    TEXT id PK
    TEXT actor_id
    TEXT action
    TEXT target_type
    TEXT target_id
    JSONB metadata
  }

  %% ─── RELACIONAMENTOS ─────────────────────────────────────

  %% Currículo (cadeia principal)
  bases        ||--o{ hubs                   : "base_slug"
  hubs         ||--o{ trails                 : "hub_id"
  trails       ||--o{ curriculum_articles    : "trail_id"
  hubs         ||--o{ curriculum_articles    : "hub_id"

  curriculum_articles ||--o{ module_blocks          : "article_slug"
  module_blocks       ||--o{ module_blocks           : "parent_id (self)"
  curriculum_articles ||--o{ module_quizzes          : "module_slug"
  curriculum_articles ||--o{ module_prerequisites    : "module_slug"
  curriculum_articles ||--o{ module_next_suggested   : "module_slug"

  %% Simulados
  bases        ||--o{ simulados              : "base_slug"
  simulados    ||--o{ questions              : "simulado_id"
  simulados    ||--o{ simulado_attempts      : "simulado_id"
  curriculum_articles ||--o{ questions       : "related_module_slug"
  simulado_attempts   ||--o| certificates    : "attempt_id"

  %% Usuário → Identidade
  users ||--o{ refresh_tokens      : "user_id"
  users ||--|| user_preferences    : "user_id"
  users ||--o| leaderboard_opt_ins : "user_id"

  %% Usuário → Progresso
  users ||--|| progress_snapshots    : "user_id"
  users ||--o{ leaderboard           : "user_id"
  users ||--o{ trail_enrollments     : "user_id"
  users ||--o{ article_bookmarks     : "user_id"
  users ||--o{ article_ratings       : "user_id"
  users ||--o{ module_quiz_attempts  : "user_id"
  trails              ||--o{ trail_enrollments     : "trail_id"
  curriculum_articles ||--o{ trail_enrollments     : "last_seen_slug"
  curriculum_articles ||--o{ article_bookmarks     : "article_slug"
  curriculum_articles ||--o{ article_ratings       : "article_slug"
  module_quizzes      ||--o{ module_quiz_attempts  : "quiz_id"

  %% Usuário → Simulados
  users ||--o{ simulado_attempts   : "user_id"
  users ||--o{ certificates        : "user_id"
  users ||--o{ question_reports    : "user_id"

  %% Usuário → Comercial
  users ||--o{ purchases           : "user_id"
  users ||--o{ user_products       : "user_id"

  %% Usuário → Social
  users ||--o{ comments            : "user_id"
  users ||--o{ referrals           : "referrer_id"
  comments ||--o{ comments         : "parent_id (self)"

  %% Plataforma
  users            ||--o{ study_requests            : "user_id"
  study_requests   ||--o{ study_request_attachments : "study_request_id"
