    {
      "id": "68d8d831-23a3-4b13-a503-deb30eb9710f",
      "type": "section",
      "position": 2,
      "data": {
        "title": "Tipar authn no TS — nunca esquecer"
      },
      "children": [
        {
          "id": "a13fee98-aaf2-4460-941a-d81da8087857",
          "type": "code_block",
          "position": 0,
          "data": {
            "language": "typescript",
            "code": "// Request padrão: user pode ser undefined — falha silenciosa\ntype UnauthenticatedRequest = Request;\n\n// Branded: só existe APÓS middleware authn\ntype AuthenticatedRequest = Request & {\n  user: User;\n  readonly __authenticated: true;\n};\n\n// Handler protegido só aceita o tipo branded\nfunction editDocument(req: AuthenticatedRequest) {\n  req.user // ← garantido existir, TS prova\n}\n\n// Middleware transforma\nfunction requireAuth(req: Request): AuthenticatedRequest {\n  const user = verifyToken(req);\n  if (!user) throw new HttpError(401);\n  return Object.assign(req, { user, __authenticated: true as const });\n}"
          }
        },
        {
          "id": "9cfb5402-3c34-4aa1-b764-b71ec5dd58c3",
          "type": "callout",
          "position": 1,
          "data": {
            "variant": "info",
            "title": "",
            "content": "Este padrão elimina a classe inteira de bugs \"esqueci de checar autenticação\". O TS não compila sem o middleware primeiro."
          }
        }
      ]
    },
