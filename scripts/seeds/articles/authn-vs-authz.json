      "children": [
        {
          "id": "3ac073e9-0ee8-4400-ab5b-d9ee79feb08e",
          "type": "paragraph",
          "position": 0,
          "data": {
            "content": [
              {
                "text": " Pipeline correto de request protegido: "
              }
            ]
          }
        },
        {
          "id": "39dca312-4b22-4b83-97ac-39178cef0d9b",
          "type": "code_block",
          "position": 1,
          "data": {
            "language": "typescript",
            "code": "// 1. Authn (quem é?) — middleware JWT, session, etc.\nconst user = await authenticate(req);\nif (!user) return 401;\n\n// 2. Authz (pode?) — check policy pro recurso\nconst canEdit = await authorize(user, 'edit', resource);\nif (!canEdit) return 403;\n\n// 3. Handler — assume identity e permission válidas\nawait handleEdit(req, user, resource);"
          }
        },
        {
          "id": "f9476857-ffb7-429f-939f-da10bee9be58",
          "type": "paragraph",
          "position": 2,
          "data": {
            "content": [
              {
                "text": "401 vs 403",
                "bold": true
              },
              {
                "text": ": 401 Unauthorized (mal nomeado — na verdade \"unauthenticated\"). 403 Forbidden (autenticado mas sem permissão). Não misture. "
              }
            ]
          }
        }
      ]
    },
    {
      "id": "5ba1fabe-03a6-44d1-ad7a-82d77031c02e",
      "type": "section",
      "position": 1,
      "data": {
        "title": "Modelos de authz comparados"
      },
      "children": [
        {
          "id": "a83da594-871b-4035-a1b5-ca081bf7403f",
          "type": "comparison_table",
          "position": 0,
          "data": {
            "columns": [
              "Modelo",
              "Quando usar",
              "Exemplo"
            ],
            "rows": [
              [
                "RBAC (role-based)",
                "90% dos apps — simples",
                "admin, editor, viewer com perms fixas"
              ],
              [
