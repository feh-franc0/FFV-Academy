    {
      "id": "4cabf794-2ac6-4580-9bd4-ffdf2cf2b79c",
      "type": "callout",
      "position": 8,
      "data": {
        "variant": "success",
        "title": "",
        "content": "Take-aways: CodeCommit = repo · CodeBuild = build · CodeDeploy = deploy · CodePipeline = orquestra · CloudFormation = IaC nativo · CDK = IaC imperativo (gera CloudFormation) · SAM = CloudFormation simplificado pra serverless · Amplify = full-stack frontend · X-Ray = tracing distribuído."
      }
    }
