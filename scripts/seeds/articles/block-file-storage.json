              ]
            ]
          }
        },
        {
          "id": "043dd33b-f44a-45f3-8760-484ebae2f3e2",
          "type": "callout",
          "position": 2,
          "data": {
            "variant": "info",
            "title": "",
            "content": "Lambda + EFS: Lambda pode montar EFS via Access Point na VPC. Útil para modelos ML grandes que não cabem no pacote de 250MB da Lambda. Cold start +1–2s ao montar."
          }
        }
      ]
    },
