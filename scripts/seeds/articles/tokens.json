    {
      "id": "922bb883-7272-48af-85ba-32b39517bc28",
      "type": "section",
      "position": 5,
      "data": {
        "title": "Tokenizer na pratica: tiktoken"
      },
      "children": [
        {
          "id": "f2080268-ee92-466d-970e-430adaa10657",
          "type": "code_block",
          "position": 0,
          "data": {
            "language": "python",
            "code": "import tiktoken\n\n# Carregar tokenizer do GPT-4\nenc = tiktoken.get_encoding(\"cl100k_base\")\n\n# Tokenizar texto\ntext = \"Machine learning e incrivel!\"\ntokens = enc.encode(text)\nprint(f\"Texto: {text}\")\nprint(f\"Tokens: {tokens}\")\nprint(f\"Total: {len(tokens)} tokens\")\n# → Texto: Machine learning e incrivel!\n# → Tokens: [22137, 6975, 3772, 42618, 48391, 0]\n# → Total: 6 tokens\n\n# Decodificar token por token\nfor t in tokens:\n    print(f\"  {t:>6} → '{enc.decode([t])}'\")\n# → 22137 → 'Machine'\n# → 6975  → ' learning'\n# → 3772  → ' e'\n# → 42618 → 'incr'\n# → 48391 → 'ivel'\n# → 0     → '!'\n\n# Comparar idiomas\nen = enc.encode(\"The cat sat on the mat\")\npt = enc.encode(\"O gato sentou no tapete\")\nprint(f\"EN: {len(en)} tokens, PT: {len(pt)} tokens\")\n# → EN: 7 tokens, PT: 9 tokens"
          }
        },
        {
          "id": "249741f1-e5b4-4483-a0ad-92f646610e29",
          "type": "callout",
          "position": 1,
          "data": {
            "variant": "info",
            "title": "",
            "content": "Instalar: pip install tiktoken. Para Claude, use o tokenizer do Anthropic ou estime ~1.3 tokens/palavra em EN, ~1.7 em PT."
          }
        }
      ]
    },
