          }
        },
        {
          "id": "c6dafd00-f093-479b-9bc2-4840755ff670",
          "type": "callout",
          "position": 2,
          "data": {
            "variant": "warning",
            "title": "",
            "content": "O erro mais comum do mundo: ❌ \"Did you went?\" → ✅ \"Did you go?\" — com \"did\", o verbo SEMPRE fica no infinitivo. O \"did\" já marca o tempo passado, então o verbo não precisa também ser passado. ❌ \"I didn't went\" → ✅ \"I didn't go\" ❌ \"Did she bought?\" → ✅ \"Did she buy?\""
          }
        }
      ]
    },
