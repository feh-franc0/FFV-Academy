      "id": "a91da79f-8778-4f2d-9265-cf3b12866d99",
      "type": "section",
      "position": 2,
      "data": {
        "title": "Refresh token rotation"
      },
      "children": [
        {
          "id": "31da5a25-bb41-4857-9fb2-dee4a0c0f28e",
          "type": "code_block",
          "position": 0,
          "data": {
            "language": "typescript",
            "code": "// Padrão: refresh uso único, rota nova a cada uso\nasync function refresh(oldRefreshToken: string) {\n  const stored = await db.refreshTokens.findUnique({ where: { text: oldRefreshToken } });\n  if (!stored || stored.usedAt) {\n    // REUSO DETECTADO — refresh roubado. Invalidar família inteira\n    if (stored) await db.refreshTokens.updateMany({\n      where: { familyId: stored.familyId },\n      data: { revokedAt: new Date() },\n    });\n    throw new Error('refresh reuse detected');\n  }\n\n  await db.refreshTokens.update({\n    where: { text: oldRefreshToken },\n    data: { usedAt: new Date() },\n  });\n\n  const newRefresh = crypto.randomBytes(32).toString('hex');\n  await db.refreshTokens.create({\n    data: { text: newRefresh, familyId: stored.familyId, userId: stored.userId },\n  });\n\n  return {\n    accessToken: signAccessToken(stored.userId, '15m'),\n    refreshToken: newRefresh,\n  };\n}"
          }
        },
        {
          "id": "f3cf378c-80f2-40ab-9bd0-a9d4d65c388a",
          "type": "callout",
          "position": 1,
          "data": {
            "variant": "info",
            "title": "",
            "content": "Detectar reuse e invalidar FAMÍLIA é o padrão seguro. Auth0, Okta, Supabase fazem isso. Sem rotation, refresh roubado = acesso permanente."
          }
        }
      ]
    },
