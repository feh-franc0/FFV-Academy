      "data": {
        "title": "Headers e defesas padrão"
      },
      "children": [
        {
          "id": "58dcbf28-8cc4-4022-9268-0c40d1181c64",
          "type": "code_block",
          "position": 0,
          "data": {
            "language": "http",
            "code": "# Headers mínimos em toda resposta HTTP (API ou web)\nStrict-Transport-Security: max-age=31536000; includeSubDomains; preload\nContent-Security-Policy: default-src 'self'; script-src 'self' 'nonce-...'; object-src 'none'\nX-Content-Type-Options: nosniff\nX-Frame-Options: DENY\nReferrer-Policy: strict-origin-when-cross-origin\nPermissions-Policy: camera=(), microphone=(), geolocation=()\nCross-Origin-Opener-Policy: same-origin\nCross-Origin-Resource-Policy: same-site"
          }
        },
        {
          "id": "defb42c2-2644-47a5-aa35-d713bfdfabf2",
          "type": "callout",
          "position": 1,
          "data": {
            "variant": "info",
            "title": "",
            "content": "Ferramenta. Rode ou contra seu domínio. Grau A é pré-requisito."
