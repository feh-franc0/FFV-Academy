    {
      "id": "1b4b31c1-3a66-470d-ad81-208970c71197",
      "type": "section",
      "position": 9,
      "data": {
        "title": "Cenários de decisão"
      },
      "children": [
        {
          "id": "83d5af79-44ae-4978-9168-75a2dbc5df1f",
          "type": "decision_box",
          "position": 0,
          "data": {
            "scenario": "Startup com MVP rodando $1k/mês, quer alertas quando passar de $1.5k",
            "winner": "AWS Budgets + SNS email alert",
            "why": "Budgets é grátis para os 2 primeiros e notifica via SNS. Cost Explorer é análise retroativa; Budgets é proativo.",
            "alternatives": []
          }
        },
        {
          "id": "923b8f07-f371-4b36-8ae0-d0f527b1bad9",
          "type": "decision_box",
          "position": 1,
          "data": {
            "scenario": "Empresa com 30 contas AWS, cada time compra RI separadamente",
            "winner": "AWS Organizations + Consolidated Billing + RI/Savings Plans sharing",
            "why": "Consolida cobrança, aumenta volume discount, permite RIs compradas em qualquer conta beneficiarem outras. Economia imediata.",
            "alternatives": []
          }
        },
        {
          "id": "a74dbab5-4b6a-4724-824e-ee5d27d0e77e",
          "type": "decision_box",
          "position": 2,
          "data": {
            "scenario": "Banco com SLA de 15 min para P1, suporte 24/7 e acesso a TAM dedicado",
            "winner": "Enterprise Support Plan",
            "why": "Único plano com TAM dedicado e SLA <15min para P1. $15k/mês mínimo. Inclui WAR Reviews ilimitadas.",
            "alternatives": [
              {
                "name": "Enterprise On-Ramp",
                "note": "TAM em pool (não dedicado), SLA 30 min — ~1/3 do custo"
              }
            ]
          }
        },
        {
          "id": "a95d3e6b-cbf1-414e-a4d9-366196a53f92",
          "type": "decision_box",
          "position": 3,
          "data": {
            "scenario": "Devs internos testando AWS, querem suporte técnico via email em horário comercial",
            "winner": "Developer Support ($29/mês ou 3% do uso)",
            "why": "Atende times de dev/teste. Para produção crítica, upgrade para Business.",
            "alternatives": []
          }
        }
      ]
    },
    {
      "id": "6d002073-6cc9-478b-96c0-54986f947e31",
      "type": "callout",
      "position": 10,
      "data": {
        "variant": "info",
        "title": "",
        "content": "Dica forte para o exame: decore o menor plano que inclui cada feature. TAM dedicado = só Enterprise. 24/7 = Business+. Todos os Trusted Advisor checks = Business+. Third-party software (OS/DB) support = Business+. Well-Architected Reviews = Enterprise On-Ramp+."
      }
    },
    {
      "id": "f3f70b95-bd0e-420a-b826-0cbf3375037b",
      "type": "section",
      "position": 11,
      "data": {
        "title": "Perguntas típicas (Q&A)"
      },
      "children": [
        {
          "id": "1b637041-8e59-4078-848d-619fb1182f4b",
          "type": "qa_item",
          "position": 0,
          "data": {
            "question": "Qual ferramenta estima o custo de uma arquitetura antes de provisioná-la?",
            "answer": "AWS Pricing Calculator. Selecione serviços, configure, compartilhe link. Ideal para apresentações e aprovações orçamentárias."
          }
        },
        {
          "id": "eda8726e-db0b-4dbc-bf7a-7b6e469c485d",
          "type": "qa_item",
          "position": 1,
          "data": {
            "question": "Em qual plano de suporte aparece AWS IQ e API de suporte?",
            "answer": "Developer em diante. IQ conecta clientes a experts independentes da AWS. API de suporte (acesso programático a tickets) está em Business+."
          }
        },
        {
          "id": "cbd53832-0e03-4e91-b93c-e4c2e039d9c2",
          "type": "qa_item",
          "position": 2,
          "data": {
            "question": "Quem é dono da conta pagadora em AWS Organizations?",
            "answer": "A Management Account (antes chamada \"Master Account\"). É a conta que recebe a fatura consolidada e tem privilégios superiores (inclui criar SCPs). Não deve rodar workloads de produção."
          }
        },
        {
          "id": "81a6dd30-0de0-488f-b35f-ea2c68992adb",
          "type": "qa_item",
          "position": 3,
          "data": {
            "question": "Qual é o plano de suporte da conta Basic e por quanto tempo?",
            "answer": "Basic é grátis e eterno. Inclui acesso a documentação, whitepapers, fóruns da comunidade, 6 Trusted Advisor checks básicos e Personal Health Dashboard. Não inclui suporte técnico humano."
          }
        }
      ]
    },
    {
      "id": "d20f6645-1ba2-458d-a896-83208befba8f",
      "type": "callout",
      "position": 12,
      "data": {
        "variant": "success",
        "title": "",
        "content": "Take-aways: Compute + Storage + Data Transfer OUT são os 3 custos principais. Free Tier tem 12 meses, always-free e trials. Savings Plans > RIs para maioria (mais flexível). Organizations = multi-account + consolidated billing + volume discounts. 4 planos de suporte: Basic (grátis) / Developer ($29) / Business ($100+) / Enterprise ($15k+), e o Enterprise On-Ramp entre os dois últimos. TAM dedicado só Enterprise. Budgets (proativo) + Cost Explorer (retrospectivo) + Pricing Calculator (pre-emptivo)."
      }
    }
  ]
