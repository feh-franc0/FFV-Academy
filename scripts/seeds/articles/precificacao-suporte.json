    {
      "id": "9c54a7bf-c90d-41ab-a99c-ea5638c3c690",
      "type": "callout",
      "position": 10,
      "data": {
        "variant": "info",
        "title": "",
        "content": "Dica forte para o exame: decore o menor plano que inclui cada feature. TAM dedicado = só Enterprise. 24/7 = Business+. Todos os Trusted Advisor checks = Business+. Third-party software (OS/DB) support = Business+. Well-Architected Reviews = Enterprise On-Ramp+."
      }
    },
    {
      "id": "c7ced9d5-2a7f-4f79-a145-9d9764e97dff",
      "type": "section",
