          "data": {
            "content": [
              {
                "text": " Muitos serviços têm Free Tier. Alguns notáveis: Lambda, DynamoDB, CloudWatch (10 custom metrics + 1M API requests), SNS (1M publishes), SQS (1M requests). Verifique sempre "
              },
              {
                "text": "aws.amazon.com/free",
                "code": true
              },
              {
                "text": ". "
              }
            ]
          }
        }
      ]
    },
