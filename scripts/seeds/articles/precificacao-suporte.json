      "data": {
        "title": "Ferramentas de billing e cost management"
      },
      "children": [
        {
          "id": "0a1c2054-d6b7-4628-b935-97279ad0d9f7",
          "type": "comparison_table",
          "position": 0,
          "data": {
            "columns": [
              "Ferramenta",
              "O que faz"
            ],
            "rows": [
              [
                "AWS Pricing Calculator",
                "Estima custo ANTES de usar (comparar arquiteturas)"
              ],
              [
                "AWS Cost Explorer",
                "Analisa custos históricos (13 meses) + previsão, com gráficos e filtros"
              ],
              [
                "AWS Budgets",
                "Define alertas de custo/uso (ex: avisar se passar $500 no mês)"
              ],
              [
                "AWS Cost and Usage Report (CUR)",
                "Dump detalhado em S3 (linha-a-linha) para BI/Athena"
              ],
              [
                "AWS Trusted Advisor",
                "Recomendações em 5 áreas (incluindo custo: idle EC2, low util RDS)"
              ],
              [
                "Cost Allocation Tags",
                "Tags em recursos para breakdown por projeto/team/env"
              ],
              [
                "Billing Conductor",
                "Simula faturamento customizado para revendedores/MSPs"
              ],
              [
                "Compute Optimizer",
                "ML recomenda right-sizing de EC2, Lambda, EBS, ASG"
              ]
            ]
          }
        }
      ]
    },
    {
      "id": "27bbb185-d42c-42d1-a3b5-7599d1aecea3",
      "type": "section",
      "position": 6,
      "data": {
        "title": "AWS Organizations e Consolidated Billing"
      },
      "children": [
        {
          "id": "ec52e35a-0b4f-4676-a5f1-e077d2fb89ef",
          "type": "paragraph",
          "position": 0,
          "data": {
            "content": [
              {
                "text": "AWS Organizations",
                "code": true
              },
              {
                "text": " permite gerenciar múltiplas contas AWS como uma única unidade. Benefícios: "
              }
            ]
          }
        },
        {
          "id": "6df15554-04a4-4bec-ab07-3180c14d8ab3",
          "type": "list",
          "position": 1,
          "data": {
            "items": [
              "• Consolidated Billing — uma fatura única para todas as contas",
              "• Volume discounts — soma de uso entre contas aumenta descontos por tier",
              "• Reserved Instance / Savings Plans sharing — RIs compradas em uma conta beneficiam outras",
              "• Service Control Policies (SCPs) — limites máximos de permissões em nível de OU/conta",
              "• Integração com Control Tower (landing zone) e SSO"
            ],
            "ordered": false
          }
        }
      ]
    },
