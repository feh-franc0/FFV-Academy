        {
          "id": "a9d3ef2f-7975-47e6-9153-9daecefe1042",
          "type": "callout",
          "position": 1,
          "data": {
            "variant": "warning",
            "title": "",
            "content": "NACL ephemeral ports: como é stateless, resposta de uma request sai por porta ephemeral (1024-65535). Se NACL não permitir outbound nessas portas, a resposta é bloqueada — e você fica sem entender por quê."
          }
        }
      ]
    },
