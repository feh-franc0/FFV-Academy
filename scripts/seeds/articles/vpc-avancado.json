              "Route table aponta para",
              "Uso"
            ],
            "rows": [
              [
                "Pública",
                "IGW em 0.0.0.0/0",
                "ALB/NLB frontais, Bastion, NAT Gateway"
              ],
              [
                "Privada (com NAT)",
                "NAT Gateway em 0.0.0.0/0",
                "EC2 app que precisa updates/APIs"
              ],
              [
                "Privada isolada",
                "Sem 0.0.0.0/0 (só local VPC)",
                "RDS, ElastiCache, bastiões sensíveis"
