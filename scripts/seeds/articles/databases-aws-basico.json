                "text": "Features essenciais:",
                "bold": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": "42487ba3-d128-4162-ad26-3466da1645e1",
      "type": "section",
      "position": 4,
      "data": {
        "title": "Amazon Aurora — o diferencial"
      },
      "children": [
        {
          "id": "dd4a9a73-39e5-4c4a-93bb-8e5d72cc2e53",
          "type": "paragraph",
          "position": 0,
          "data": {
            "content": [
              {
                "text": " Proprietário AWS, compatível com PostgreSQL e MySQL. Arquitetura de storage distribuído em "
              },
              {
                "text": "6 cópias em 3 AZs",
                "bold": true
              },
              {
                "text": ". Auto-scale de storage até 128 TB. Failover <30s. "
              }
            ]
          }
        },
        {
          "id": "aabf2ac2-0d3e-4e1e-b2dd-9054247d6062",
          "type": "paragraph",
          "position": 1,
          "data": {
            "content": [
              {
                "text": "Benefícios vs RDS vanilla:",
                "bold": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": "164867f3-66aa-46c5-b963-4ca4261e29ab",
      "type": "section",
      "position": 5,
      "data": {
        "title": "Amazon DynamoDB"
      },
      "children": [
        {
          "id": "8fd161b5-4cc0-41a3-a6d8-e5d2de68278b",
          "type": "paragraph",
          "position": 0,
          "data": {
            "content": [
              {
                "text": " NoSQL key-value e document, serverless, escala horizontal ilimitada, latência single-digit ms. Pagamento por "
              },
              {
                "text": "capacidade provisionada",
                "bold": true
              },
              {
                "text": " (leituras/segundo) ou "
              },
              {
                "text": "On-Demand",
                "bold": true
              },
              {
                "text": " (paga por requisição). "
              }
            ]
          }
        },
        {
          "id": "2c73482a-2804-4f22-86f0-ddb1d75dbafc",
          "type": "paragraph",
          "position": 1,
          "data": {
            "content": [
              {
                "text": "Features únicas:",
                "bold": true
              }
            ]
          }
        },
        {
          "id": "73726583-7cfb-4ff1-9722-c086f5e85bdb",
          "type": "callout",
          "position": 2,
          "data": {
            "variant": "info",
            "title": "",
            "content": "Padrão do exame: \"Escala horizontal massiva, baixa latência, sem schema rígido\" → DynamoDB. \"Transações ACID complexas com JOINs\" → RDS/Aurora."
          }
        }
      ]
    },
    {
      "id": "184380b1-1853-4ef0-8fc1-a99f3ef0b902",
      "type": "section",
      "position": 6,
      "data": {
        "title": "Redshift — data warehouse"
      },
      "children": [
        {
          "id": "729d1671-6fe0-4e2e-9c64-4e48920e86e5",
          "type": "paragraph",
          "position": 0,
          "data": {
            "content": [
              {
                "text": " Data warehouse colunar, MPP (Massively Parallel Processing), até petabytes. Baseado em PostgreSQL modificado. Features: "
              }
            ]
          }
        }
      ]
    },
    {
      "id": "1de5cd39-ea1a-49eb-8b26-5a1215731662",
      "type": "section",
      "position": 7,
      "data": {
        "title": "ElastiCache — cache in-memory"
      },
      "children": [
        {
          "id": "a1eecf71-8dfa-4544-8916-f14e6137d5ec",
          "type": "comparison_table",
          "position": 0,
          "data": {
            "columns": [
              "Engine",
              "Uso",
              "Recurso principal"
            ],
            "rows": [
              [
                "Redis",
                "Cache + estrutura de dados rica + pub/sub",
                "Persistência, replicação, clustering"
              ],
              [
                "Memcached",
                "Cache simples, ultra-leve",
                "Multi-threaded, particionamento simples"
              ]
            ]
          }
        },
        {
          "id": "d832a1bc-c638-4770-9610-6de750845f27",
          "type": "paragraph",
          "position": 1,
          "data": {
            "content": [
              {
                "text": "ElastiCache é usado como camada de cache na frente de RDS/DynamoDB para reduzir latência e custo."
              }
            ]
          }
        }
      ]
    },
    {
      "id": "40782e5e-2c31-41da-8361-485702334ac3",
