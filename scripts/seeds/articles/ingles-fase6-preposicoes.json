          "data": {
            "columns": [
              "Combinação",
              "Exemplo",
              "Tradução"
            ],
            "rows": [
              [
                "interested IN",
                "I'm interested in learning.",
                "Estou interessado em aprender."
              ],
              [
                "good AT",
                "She's good at math.",
                "Ela é boa em matemática."
              ],
              [
                "afraid OF",
                "He's afraid of spiders.",
