          "type": "callout",
          "position": 1,
          "data": {
            "variant": "warning",
            "title": "",
            "content": "Indirect é o vetor que ataca produção em 2026: agente lê e-mail, PR de cliente, ticket de suporte, página web. Cada fonte externa é input não-confiável."
          }
        }
      ]
    },
