    {
      "id": "5580002d-a6c9-4d33-b03d-2fc4019aeb1c",
      "type": "section",
      "position": 6,
      "data": {
        "title": "Uso prático: gerando 10s de vídeo no Hunyuan Video (open)"
      },
      "children": [
        {
          "id": "f558bf32-a594-4350-b87e-41ed2964d8a9",
          "type": "code_block",
          "position": 0,
          "data": {
            "language": "python",
            "code": "# Pseudocódigo — diffusers já tem pipeline para vários modelos\nfrom diffusers import HunyuanVideoPipeline\nimport torch\n\npipe = HunyuanVideoPipeline.from_pretrained(\n    \"tencent/HunyuanVideo\",\n    torch_dtype=torch.bfloat16,\n).to(\"cuda\")\npipe.enable_model_cpu_offload()       # 60GB VRAM → 24GB caber\n\nvideo = pipe(\n    prompt=\"a samurai walking through a bamboo forest at dawn, mist, soft sunlight, cinematic\",\n    height=720, width=1280,\n    num_frames=129,                    # ~5.4s @ 24fps\n    num_inference_steps=30,\n    guidance_scale=6.0,\n    generator=torch.Generator(device=\"cuda\").manual_seed(42),\n).frames[0]\n\nfrom diffusers.utils import export_to_video\nexport_to_video(video, \"samurai.mp4\", fps=24)",
            "filename": "hunyuan_video.py"
          }
        },
        {
          "id": "79261539-863e-4812-b282-7d9350d98de2",
          "type": "callout",
          "position": 1,
          "data": {
            "variant": "warning",
            "title": "",
            "content": "Custo computacional real: gerar 5s @ 720p em Hunyuan Video toma ~5-8 minutos em H100 (cerca de $0.50-$1 em on-demand pricing). Em consumer 4090 com offload é ~25-40 minutos. Sora 2 / Veo 3 não publicam tempo de inferência mas inferência por API custa ~$0.50-$2 por clipe de 10s."
          }
        }
      ]
    },
