        {
          "id": "b7142974-9d2f-4194-bf26-c1e9850fe8a8",
          "type": "callout",
          "position": 1,
          "data": {
            "variant": "success",
            "title": "",
            "content": "Open-weights sério em vídeo é uma realidade nova (Hunyuan Video, Wan, Mochi). Antes de fim-de-2024 só havia AnimateDiff (motion modules sobre SD). Em 2026 a brecha entre open e closed é ~6 meses, não anos."
          }
        }
      ]
