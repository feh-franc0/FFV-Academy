        "title": "STRIDE em uma tabela"
      },
      "children": [
        {
          "id": "da47b49c-f059-45de-ae0c-9332c8fc5341",
          "type": "comparison_table",
          "position": 0,
          "data": {
            "columns": [
              "Letra",
              "Ameaça",
              "Propriedade quebrada",
              "Defesa típica"
            ],
            "rows": [
              [
                "S",
                "Spoofing — forjar identidade",
                "Authentication",
                "MFA, certificados, signed tokens"
              ],
              [
                "T",
                "Tampering — modificar dado",
                "Integrity",
                "HMAC, checksums, signatures, WORM"
              ],
              [
                "R",
                "Repudiation — negar ação",
                "Non-repudiation",
                "Logs imutáveis, audit trail, signatures"
              ],
              [
                "I",
                "Information disclosure",
                "Confidentiality",
                "Encryption at rest + in transit, least privilege"
              ],
              [
                "D",
                "Denial of service",
                "Availability",
                "Rate limiting, autoscaling, circuit breakers"
              ],
              [
                "E",
