          "position": 0,
          "data": {
            "content": [
              {
                "text": "Você é solo founder BR vendendo SaaS / serviços para clientes US/EU. Estrutura comum: "
              },
              {
                "text": "LLC Delaware",
                "bold": true
              },
              {
                "text": " opera, recebe via "
              },
              {
                "text": "Stripe + Mercury USD",
                "bold": true
              },
              {
                "text": "; você (pessoa física BR) é membro único, retira como distribuição, declara no Brasil via carnê-leão. Cada peça tem motivo."
              }
            ]
          }
        }
