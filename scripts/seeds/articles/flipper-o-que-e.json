        },
        {
          "id": "7f887c8e-b986-48bf-97aa-e067f4cd230d",
          "type": "callout",
          "position": 1,
          "data": {
            "variant": "success",
            "title": "",
            "content": "Tratamos o Flipper como objeto de engenharia. Por que um protocolo é vulnerável, como a falha foi documentada na literatura, e como mitigar — não como receita de invasão. A próxima aula entra no hardware: STM32WB55, CC1101, ST25R3916."
          }
        }
      ]
