      "id": "d0560892-b2b7-488b-81a9-870bf0603d62",
      "type": "section",
      "position": 0,
      "data": {
        "title": "Pgbouncer modos"
      },
      "children": [
        {
          "id": "a4aadcdf-d4ae-4a44-bc54-9a3268bcd7c1",
          "type": "comparison_table",
          "position": 0,
          "data": {
            "columns": [
              "Mode",
              "Quando libera conn",
              "Trade-off"
            ],
            "rows": [
              [
                "session",
                "No DISCONNECT do client",
                "Sem pooling real; só middleman"
              ],
              [
                "transaction",
                "No COMMIT/ROLLBACK",
                "Default moderno; perde LISTEN/NOTIFY, session temp tables, prepared statements (PG 14+ ajuda)"
              ],
              [
                "statement",
                "Após cada statement",
                "Maior pooling; perde prepared, multi-statement tx"
              ]
            ]
          }
        }
      ]
    },
    {
      "id": "41fe2f89-861b-4af9-9888-1585fc2b849a",
      "type": "section",
      "position": 1,
      "data": {
        "title": "Config pgbouncer exemplo"
      },
      "children": [
        {
          "id": "60cc6ffd-4b14-4053-94a4-58f9f0f1a7e3",
          "type": "code_block",
          "position": 0,
          "data": {
            "language": "ini",
            "code": "# pgbouncer.ini\n[databases]\nmydb = host=pg-primary port=5432 dbname=mydb\n\n[pgbouncer]\nlisten_addr = 0.0.0.0\nlisten_port = 6432\nauth_type = md5\npool_mode = transaction\nmax_client_conn = 10000      # clients lógicos\ndefault_pool_size = 20       # conns físicas por database\nreserve_pool_size = 5\nreserve_pool_timeout = 3\n\n# App conecta em pgbouncer:6432 em vez de pg:5432"
          }
        }
      ]
    },
    {
      "id": "2a5de799-a92d-413a-b628-94dd5f2f1d36",
      "type": "section",
      "position": 2,
      "data": {
        "title": "Serverless options"
      },
      "children": [
        {
          "id": "41cb2c98-3896-4d1b-b4fb-e8b380c6b194",
          "type": "callout",
          "position": 0,
          "data": {
            "variant": "info",
            "title": "",
            "content": "Em 2026, se você escolhe Postgres pra serverless (Lambda, Cloudflare Workers, Vercel Edge), pooler é obrigatório. Ignorar vai estourar em produção mais cedo ou mais tarde."
          }
        }
      ]
    }
  ]
}