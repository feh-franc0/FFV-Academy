    {
      "id": "c6d3f0f8-f898-428b-9374-0b892d5ba5cf",
      "type": "section",
      "position": 10,
      "data": {
        "title": "Referências e leitura técnica"
      },
      "children": [
        {
          "id": "30188210-7847-43ae-a0c0-a1477f163032",
          "type": "callout",
          "position": 0,
          "data": {
            "variant": "info",
            "title": "",
            "content": "Para entender ataques side-channel em smartcards: Mangard, Oswald, Popp, Power Analysis Attacks: Revealing the Secrets of Smart Cards (Springer). Para EMV a fundo: EMV Book 2 — Security and Key Management, disponível gratuitamente em emvco.com."
          }
        }
      ]
    }
  ]
}