      "type": "section",
      "position": 1,
      "data": {
        "title": "A01 — Broken Access Control (IDOR)"
      },
      "children": [
        {
          "id": "9389c6f3-f65c-4681-b9e0-fcf239e8e4fc",
          "type": "code_block",
          "position": 0,
          "data": {
            "language": "typescript",
            "code": "// ❌ RUIM — só checa autenticação\napp.get('/orders/:id', requireAuth, async (req) => {\n  const order = await db.order.findUnique({ where: { id: req.params.id } });\n  return order;  // qualquer user logado vê qualquer order\n});\n\n// ✅ OK — check de owner no query\napp.get('/orders/:id', requireAuth, async (req) => {\n  const order = await db.order.findFirst({\n    where: { id: req.params.id, userId: req.user.id },\n  });\n  if (!order) return 404;\n  return order;\n});"
          }
        }
      ]
    },
    {
      "id": "764b2439-11a7-41d6-a883-ffa892194e7b",
      "type": "section",
      "position": 2,
      "data": {
        "title": "A03 — Injection"
      },
      "children": [
        {
          "id": "f9306bf4-0ac2-4284-8984-d28584248f3c",
          "type": "code_block",
          "position": 0,
          "data": {
            "language": "typescript",
            "code": "// ❌ SQLi clássico\nconst raw = await db.query(\n  `SELECT * FROM users WHERE email = '${req.body.email}'`\n);\n\n// ✅ Parametrized\nconst raw = await db.query(\n  'SELECT * FROM users WHERE email = $1',\n  [req.body.email]\n);\n\n// ✅ ORM (recomendado)\nconst user = await prisma.user.findUnique({ where: { email: req.body.email } });"
          }
        },
        {
          "id": "05b05412-18ff-4014-8e00-b430176f09c1",
          "type": "paragraph",
          "position": 1,
          "data": {
            "content": [
              {
                "text": " XSS (variante de injection no HTML): React já escapa "
              },
              {
                "text": "{value}",
                "code": true
              },
              {
                "text": " por default. Cuidado com "
              },
              {
                "text": "dangerouslySetInnerHTML",
                "code": true
              },
              {
                "text": " — só use se sanitizar com DOMPurify. "
              },
              {
                "text": "href={url}",
                "code": true
              },
              {
                "text": " com "
              },
              {
                "text": "url",
                "code": true
              },
              {
                "text": " do user pode virar "
              },
              {
                "text": "javascript:",
                "code": true
              },
              {
                "text": "; valide com URL constructor. "
              }
            ]
          }
        }
      ]
    },
    {
      "id": "128ce232-0fc2-42e8-abc3-e7300cae74b0",
      "type": "section",
      "position": 3,
      "data": {
        "title": "A10 — SSRF e fetch de URLs externas"
      },
      "children": [
        {
          "id": "e76e034e-584a-4e10-a991-033373832455",
          "type": "code_block",
          "position": 0,
          "data": {
            "language": "typescript",
            "code": "// ❌ Vulnerável — user passa URL, server fetch\napp.post('/import-avatar', async (req) => {\n  const img = await fetch(req.body.url);  // SSRF!\n  // req.body.url = \"http://169.254.169.254/latest/meta-data/iam/...\"\n  // → vaza IAM role\n});\n\n// ✅ Whitelist de domínios + bloqueio de ranges privados\nconst ALLOWED = ['imgur.com', 'i.imgur.com', 's3.amazonaws.com'];\nconst PRIVATE_RANGES = [/^10\\./, /^172\\.(1[6-9]|2\\d|3[01])\\./, /^192\\.168\\./, /^127\\./, /^169\\.254\\./];\n\nfunction safeUrl(raw: string): URL | null {\n  try {\n    const u = new URL(raw);\n    if (u.protocol !== 'https:') return null;\n    if (!ALLOWED.includes(u.hostname)) return null;\n    // Resolve DNS e checa IP (evita rebinding)\n    return u;\n  } catch { return null; }\n}\n\n// Extra: usar proxy dedicado, timeout, body size limit."
          }
        }
      ]
    },
