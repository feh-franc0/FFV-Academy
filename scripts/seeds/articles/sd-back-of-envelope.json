          "type": "paragraph",
          "position": 0,
          "data": {
            "content": [
              {
                "text": "Memorize essa tabela. Ela cobre 90% dos cálculos que aparecem em entrevista sênior."
              }
            ]
          }
        },
        {
          "id": "5794a456-eaea-4c17-92d1-38c395eeede9",
          "type": "comparison_table",
          "position": 1,
          "data": {
            "columns": [
              "Grandeza",
              "Valor memorizar",
              "Uso"
            ],
            "rows": [
              [
                "Segundos/dia",
