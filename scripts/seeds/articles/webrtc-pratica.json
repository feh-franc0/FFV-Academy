    {
      "id": "c45dc224-f96a-4fe0-a8a6-377d6a0af112",
      "type": "section",
      "position": 7,
      "data": {
        "title": "Pitfalls comuns"
      },
      "children": [
        {
          "id": "7933ec10-8417-4068-9445-b38af96b8c47",
          "type": "key_value",
          "position": 0,
          "data": {
            "items": [
              {
                "k": "Achar que STUN basta",
                "v": "10-20% dos usuários precisam de TURN. Sem TURN, falha em rede corporativa."
              },
              {
                "k": "Esquecer permissão HTTPS",
                "v": "getUserMedia exige contexto seguro (HTTPS ou localhost)."
              },
              {
                "k": "Não tratar perda de conexão",
                "v": "ICE pode reconectar; implemente UI de reconexão."
              },
              {
                "k": "Bandwidth ilimitado no cliente",
                "v": "Em mesh, upload do client cresce linearmente. Use simulcast/SVC."
              },
              {
                "k": "Não medir QoS",
                "v": "getStats() devolve packet loss, jitter, RTT. Logue para troubleshoot."
              }
            ]
          }
        }
      ]
    }
  ]
