          "type": "comparison_table",
          "position": 0,
          "data": {
            "columns": [
              "Topologia",
              "Como funciona",
              "Quando usar"
            ],
            "rows": [
              [
                "Mesh (P2P full)",
                "Cada um conecta com cada um (N×(N-1)/2 conexões)",
