    {
      "id": "c0066154-ea53-4edf-bb99-adb511698519",
      "type": "section",
      "position": 5,
      "data": {
        "title": "NAT traversal — o problema do mundo real"
      },
      "children": [
        {
          "id": "b27a8399-2359-4005-8b1a-fc4647944e9d",
          "type": "paragraph",
          "position": 0,
          "data": {
            "content": [
              {
                "text": " A maioria dos clientes está atrás de NAT (residencial, corporativo, mobile). ICE (Interactive Connectivity Establishment, RFC 8445) tenta múltiplos caminhos: "
              }
            ]
          }
        },
        {
          "id": "23494599-317d-4424-a4b9-d4b494f7f153",
          "type": "node_graph",
          "position": 1,
          "data": {
            "title": "Tipos de NAT — em ordem de dificuldade",
            "columns": [
              {
                "label": "Fáceis (P2P funciona)",
                "nodes": [
                  {
                    "icon": "🟢",
                    "label": "Full Cone NAT",
                    "sub": "Qualquer IP externo pode enviar",
                    "tone": "success"
                  },
                  {
                    "icon": "🟢",
                    "label": "Restricted Cone",
                    "sub": "Só IPs que recebemos pacote"
                  }
                ]
              },
              {
                "label": "Médios (STUN ajuda)",
                "nodes": [
                  {
                    "icon": "🟡",
                    "label": "Port-Restricted Cone",
                    "sub": "IP + porta específicos"
                  }
                ]
              },
              {
                "label": "Difíceis (TURN obrigatório)",
                "nodes": [
                  {
                    "icon": "🔴",
                    "label": "Symmetric NAT",
                    "sub": "Porta externa muda por destino",
                    "tone": "danger"
                  },
                  {
                    "icon": "🔴",
                    "label": "Firewall corporativo bloqueando UDP",
                    "sub": "Cai pra TURN/TCP/443",
                    "tone": "danger"
                  }
                ]
              }
            ],
            "legend": []
          }
        }
      ]
    },
