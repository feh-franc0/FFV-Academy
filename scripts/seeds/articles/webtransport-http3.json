    {
      "id": "1a105a68-2954-4c51-8a8a-ddf32ef9bdd0",
      "type": "section",
      "position": 6,
      "data": {
        "title": "Pitfalls em produção"
      },
      "children": [
        {
          "id": "2d692172-354b-482b-9bea-84cb548753d9",
          "type": "key_value",
          "position": 0,
          "data": {
            "items": [
              {
                "k": "Suporte em proxies corporativos",
                "v": "Alguns proxies não falam HTTP/3. Fallback para WebSocket é prudente."
              },
              {
                "k": "Debugging mais difícil",
                "v": "Wireshark precisa de chaves TLS para descriptografar QUIC. Use logging estruturado."
              },
              {
                "k": "Certificate pinning",
                "v": "WebTransport browser permite restrição por certificate hash (serverCertificateHashes) — útil para PKI custom."
              },
              {
                "k": "Não confundir com HTTP/3 normal",
                "v": "WebTransport é uma API específica, não \"uso HTTP/3\""
              },
              {
                "k": "Backpressure manual",
                "v": "Streams ReadableStream/WritableStream — não esquece o backpressure"
              }
            ]
          }
        }
      ]
    }
  ]
