                "Sim (TLS + KMS)",
                "In-transit sim, at-rest não"
              ],
              [
                "Caso de uso",
                "Session store, leaderboards, filas, geo, pub/sub",
                "Cache puro simples, multi-thread, sem persistência"
              ]
            ]
          }
        },
        {
          "id": "3d653416-e249-4294-8ca3-08f60ba67635",
          "type": "callout",
          "position": 1,
          "data": {
            "variant": "info",
            "title": "",
            "content": "Regra prática: na dúvida, escolha Redis. Memcached só ganha se você precisa estritamente de multithread e não liga para persistência/replicação. Exame favorece Redis em quase todo cenário."
          }
        }
      ]
    },
    {
