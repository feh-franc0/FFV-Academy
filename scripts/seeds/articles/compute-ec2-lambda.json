    {
      "id": "e9c7c3bd-497e-485e-b91d-4320430f6bd6",
      "type": "section",
      "position": 9,
      "data": {
        "title": "Cenários de decisão"
      },
      "children": [
        {
          "id": "c3970417-fcc7-45c1-9213-ee254495ec82",
          "type": "decision_box",
          "position": 0,
          "data": {
            "scenario": "API REST com picos imprevisíveis e baixa latência",
            "winner": "API Gateway + Lambda",
            "why": "Zero gestão, escala de 0 a milhares de reqs/s automaticamente, paga só pelo uso. Free Tier eterno cobre projetos pequenos.",
            "alternatives": [
              {
                "name": "EC2 + ALB",
                "note": "Viável se você quer controle total, mas custo fixo mesmo sem uso"
              }
            ]
          }
        },
        {
          "id": "34b7c2fb-232b-417c-b463-f52f3e2b368e",
          "type": "decision_box",
          "position": 1,
          "data": {
            "scenario": "Processamento noturno pesado (ETL de logs) por 4h",
            "winner": "AWS Batch em Spot",
            "why": "Spot economiza até 90% vs On-Demand. Batch retry-automático lida com interrupções. Tolerância a falha nativa.",
            "alternatives": [
              {
                "name": "EMR",
                "note": "Se envolver Hadoop/Spark diretamente, EMR simplifica"
              },
              {
                "name": "Lambda",
                "note": "Limite de 15 min inviabiliza jobs longos"
              }
            ]
          }
        },
        {
          "id": "7073028d-7900-43fe-8861-efcb030e655b",
          "type": "decision_box",
          "position": 2,
          "data": {
            "scenario": "Aplicação monolítica .NET legada migrando do on-prem",
            "winner": "EC2 (ou Elastic Beanstalk)",
            "why": "Migração lift-and-shift preserva o binário. Depois de estabilizar, considere containerizar (ECS) ou refatorar para serverless.",
            "alternatives": []
          }
        },
        {
          "id": "3a1dd436-c914-4e86-a1f5-c9935e7bb736",
          "type": "decision_box",
          "position": 3,
          "data": {
            "scenario": "Cluster Kubernetes multi-time, múltiplos microsserviços",
            "winner": "EKS + Fargate (para cargas leves) + EC2 (para cargas pesadas)",
            "why": "EKS dá o ecossistema K8s completo. Fargate elimina gestão de nós para workloads típicas; EC2 worker nodes quando você precisa DaemonSets, GPU ou customização.",
            "alternatives": []
          }
        }
      ]
    },
    {
      "id": "0a6d8b43-8d86-4ab0-906a-7544bbe1ae1b",
      "type": "section",
      "position": 10,
      "data": {
        "title": "Exemplos práticos"
      },
      "children": [
        {
          "id": "f232b62c-786b-4cca-897d-a6cc4bd55a48",
          "type": "code_block",
          "position": 0,
          "data": {
            "language": "bash — EC2",
            "code": "# Lançar uma t3.micro (Free Tier elegível)\naws ec2 run-instances \\\n  --image-id ami-0c55b159cbfafe1f0 \\\n  --instance-type t3.micro \\\n  --key-name minha-chave \\\n  --security-group-ids sg-012345 \\\n  --subnet-id subnet-abc123 \\\n  --count 1"
          }
        },
        {
          "id": "e6cb1c07-3edf-4a54-a60a-93462d0d237b",
          "type": "code_block",
          "position": 1,
          "data": {
            "language": "bash — Lambda",
            "code": "# Criar função\naws lambda create-function \\\n  --function-name olaMundo \\\n  --runtime python3.12 \\\n  --role arn:aws:iam::123:role/lambda-role \\\n  --handler app.lambda_handler \\\n  --zip-file fileb://deploy.zip\n\n# Invocar\naws lambda invoke \\\n  --function-name olaMundo \\\n  --payload '{\"nome\":\"AWS\"}' resposta.json"
          }
        },
        {
          "id": "48ea1788-d83c-479f-8aa1-9a9069a86408",
          "type": "code_block",
          "position": 2,
          "data": {
            "language": "bash — ECS Fargate",
            "code": "# Criar task definition + rodar tarefa\naws ecs run-task \\\n  --cluster meu-cluster \\\n  --task-definition minha-task:1 \\\n  --launch-type FARGATE \\\n  --network-configuration \"awsvpcConfiguration={subnets=[subnet-abc],securityGroups=[sg-012]}\""
          }
        }
      ]
    },
    {
      "id": "50efac90-62de-464b-a898-c3724d30203a",
      "type": "callout",
      "position": 11,
      "data": {
        "variant": "warning",
        "title": "",
        "content": "Armadilha clássica: \"Serverless não tem servidor\" é meia-verdade. O servidor existe (AWS gerencia). O ponto é que VOCÊ não gerencia. Para o exame, serverless = Lambda + Fargate + DynamoDB + Aurora Serverless + API Gateway + SQS + SNS."
      }
    },
    {
      "id": "389a97cc-edb6-4436-aa2d-ce4271cffd59",
      "type": "section",
      "position": 12,
      "data": {
        "title": "Perguntas típicas (Q&A)"
      },
      "children": [
        {
          "id": "7bef676d-7780-4877-bda8-5d12d07c9777",
          "type": "qa_item",
          "position": 0,
          "data": {
            "question": "Qual instance family usar para uma aplicação que cacheia Redis em memória (50 GB de dados)?",
            "answer": "Memory Optimized (família R ou X). Um tem 128 GB RAM — suficiente para 50 GB de cache com folga."
          }
        },
        {
          "id": "b73407be-787b-4e58-b210-af7ca2d64fd3",
          "type": "qa_item",
          "position": 1,
          "data": {
            "question": "Qual é a menor unidade de cobrança do Lambda?",
            "answer": "Com o billing moderno, é por milissegundo (antes eram 100ms). Memória é cobrada em GB-segundos. Invocação cobrada por requisição."
          }
        },
        {
          "id": "352980eb-b469-4777-b73a-c0d8eb8dad8f",
          "type": "qa_item",
          "position": 2,
          "data": {
            "question": "Empresa precisa BYOL (Bring Your Own License) Windows Server. Qual modelo EC2?",
            "answer": ". Fornece o host físico dedicado, permitindo reuso de licenças Microsoft antigas que exigem socket físico."
          }
        },
        {
          "id": "d130062d-94f3-41f2-afc5-40a57e2cd2ab",
          "type": "qa_item",
          "position": 3,
          "data": {
            "question": "Para proteger sua EC2 contra interrupções Spot, qual alternativa balanceia custo e estabilidade?",
            "answer": "Savings Plans ou Reserved Instances. Ambos dão desconto grande (até 72%) mas sem risco de interrupção como Spot."
          }
        }
      ]
    },
    {
      "id": "7cf9da9d-8d1b-495b-a29b-a2289c9235ca",
      "type": "callout",
      "position": 13,
      "data": {
        "variant": "success",
        "title": "",
        "content": "Take-aways: EC2 = VMs com 5 famílias (general/compute/memory/storage/accelerated) e 5 modelos de compra (On-Demand/Reserved/Savings Plans/Spot/Dedicated). Lambda = serverless, 15 min máx, paga por ms. ECS/EKS = containers; Fargate = modo serverless deles. Beanstalk/Lightsail = PaaS. Spot = 90% off mas interrompível. Savings Plans = flexibilidade + desconto."
      }
    }
  ]
}