    {
      "id": "4060a7ed-9380-473d-8288-0339e7fbdcec",
      "type": "section",
      "position": 2,
      "data": {
        "title": "will-change com cautela"
      },
      "children": [
        {
          "id": "5f63ae0d-3dae-4015-a40e-9138936ab683",
          "type": "code_block",
          "position": 0,
          "data": {
            "language": "css",
            "code": "/* ❌ NÃO faça */\n* {\n  will-change: transform, opacity;  /* destrói memory */\n}\n\n/* ✅ Aplicação cirúrgica */\n.card {\n  /* sem will-change por default */\n}\n.card.is-animating {\n  will-change: transform;  /* só durante animação */\n}"
          }
        },
        {
          "id": "272db5f6-3e74-4e7e-ba0c-9d3b68352831",
          "type": "code_block",
          "position": 1,
          "data": {
            "language": "typescript",
            "code": "// JS pattern: add antes, remove depois\nfunction animateCard(card: HTMLElement) {\n  card.style.willChange = 'transform';\n  card.animate(\n    [{ transform: 'translateY(0)' }, { transform: 'translateY(-20px)' }],\n    { duration: 300, easing: 'cubic-bezier(0.4, 0, 0.2, 1)' }\n  ).addEventListener('finish', () => {\n    card.style.willChange = 'auto';  // libera\n  });\n}"
          }
        }
      ]
    },
    {
      "id": "1bd43a59-7bfc-480c-9693-32c1627096d8",
      "type": "section",
      "position": 3,
      "data": {
        "title": "prefers-reduced-motion — implementação"
      },
      "children": [
        {
          "id": "e1de7c12-503f-4d71-b355-5a957a435730",
          "type": "code_block",
          "position": 0,
          "data": {
            "language": "css",
            "code": "/* CSS — fallback global */\n@media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n}"
          }
        },
        {
          "id": "5766e588-0bf7-44ef-98bd-a5bb3d452cca",
          "type": "code_block",
          "position": 1,
          "data": {
            "language": "typescript",
            "code": "// JS — em motion libs\nconst reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n\nif (reduced) {\n  // Pular animação ou cair para fade simples\n  element.style.opacity = '1';\n} else {\n  // Animação completa\n  element.animate(/* ... */);\n}\n\n// Em Framer Motion / Motion lib\nimport { useReducedMotion } from 'framer-motion';\nconst shouldReduce = useReducedMotion();"
          }
        }
      ]
    },
