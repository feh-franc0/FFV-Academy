    {
      "id": "222cc68a-238f-4e8a-93aa-83ac67443453",
      "type": "section",
      "position": 9,
      "data": {
        "title": "Cenários de decisão"
      },
      "children": [
        {
          "id": "f9678336-a9c5-4f99-95aa-23abf5d55a91",
          "type": "decision_box",
          "position": 0,
          "data": {
            "scenario": "Armazenar senha de RDS com rotação automática a cada 30 dias",
            "winner": "AWS Secrets Manager",
            "why": "Rotação automática via Lambda integrada com RDS, integração nativa, auditoria via CloudTrail.",
            "alternatives": [
              {
                "name": "Parameter Store",
                "note": "Mais barato mas sem rotação automática nativa"
              }
            ]
          }
        },
        {
          "id": "76035a2e-bb3c-4c8f-a9a8-168cd1bad37c",
          "type": "decision_box",
          "position": 1,
          "data": {
            "scenario": "E-commerce sofreu ataque DDoS de 500 Gbps",
            "winner": "AWS Shield Advanced + CloudFront + WAF",
            "why": "Shield Advanced tem mitigação dedicada para ataques grandes, acesso 24/7 à DRT (DDoS Response Team), cobertura de custos de scaling emergencial. Combinado com WAF para camada 7.",
            "alternatives": []
          }
        },
        {
          "id": "4f988808-bd51-45e1-a5d3-2e31d1150e4c",
          "type": "decision_box",
          "position": 2,
          "data": {
            "scenario": "Compliance LGPD — identificar CPFs armazenados indevidamente em buckets S3",
            "winner": "Amazon Macie",
            "why": "Macie usa ML para identificar PII/PHI em objetos S3. Gera alertas e relatórios. Nativamente integrado com S3.",
            "alternatives": []
          }
        },
        {
          "id": "9c8733ae-0efb-47fd-a15f-36cf00139e91",
          "type": "decision_box",
          "position": 3,
          "data": {
            "scenario": "Usuários finais de um app mobile precisam fazer login social (Google, Apple)",
            "winner": "Amazon Cognito User Pools",
            "why": "Cognito é purpose-built para identidades de aplicação. Suporta login social, MFA, JWT tokens. IAM é para credenciais AWS, não para usuários finais.",
            "alternatives": []
          }
        },
        {
          "id": "98937e92-733d-4013-a238-09450f7292b5",
          "type": "decision_box",
          "position": 4,
          "data": {
            "scenario": "Auditoria exige que toda chave de criptografia seja gerada em HSM dedicado certificado FIPS 140-2 Level 3",
            "winner": "AWS CloudHSM",
            "why": "HSM single-tenant exclusivamente seu. KMS é multi-tenant (compartilhado com outros clientes). Use CloudHSM quando a compliance exige controle absoluto do material criptográfico.",
            "alternatives": []
          }
        }
      ]
    },
    {
      "id": "df6326dd-9eff-40d9-a914-6fb76b19732e",
      "type": "callout",
      "position": 10,
      "data": {
        "variant": "warning",
        "title": "",
        "content": "Pegadinha clássica: Shield ≠ WAF. Shield protege contra DDoS (volume, protocolo). WAF protege contra ataques de aplicação (SQL injection, XSS). Shield Standard é grátis em todas as contas; Shield Advanced é $3k/mês com benefícios extra."
      }
    },
    {
      "id": "021ba960-95c7-47d3-a5cf-ade02c1bd08d",
      "type": "section",
      "position": 11,
      "data": {
        "title": "Perguntas típicas (Q&A)"
      },
      "children": [
        {
          "id": "478c0dd8-c5bc-40c0-addf-23c2aa8ccb98",
          "type": "qa_item",
          "position": 0,
          "data": {
            "question": "Qual serviço permite baixar relatórios SOC 2 da AWS?",
            "answer": "AWS Artifact. Portal self-service de compliance docs (SOC 1/2/3, ISO 27001, PCI-DSS AOC, HIPAA BAA). Alguns exigem clique em NDA antes do download."
          }
        },
        {
          "id": "98060ad7-bc3f-4612-ac93-5c6e03c4d1c9",
          "type": "qa_item",
          "position": 1,
          "data": {
            "question": "Diferença entre CloudTrail e Config?",
            "answer": "CloudTrail = API calls (\"quem fez o quê\"). Config = estado dos recursos e mudanças (\"o que mudou em 15/abr às 14:32?\"). Use os dois em combinação."
          }
        },
        {
          "id": "ba363655-324b-44ba-ae1e-c07356549783",
          "type": "qa_item",
          "position": 2,
          "data": {
            "question": "Serviço que consolida findings de GuardDuty, Inspector, Macie em um único dashboard?",
            "answer": "AWS Security Hub. Agrega, prioriza e correlaciona findings. Também avalia postura contra frameworks (CIS AWS Benchmark, PCI-DSS)."
          }
        },
        {
          "id": "c147c784-4ec7-41c0-b710-6b4abb822270",
          "type": "qa_item",
          "position": 3,
          "data": {
            "question": "Trusted Advisor — quais são as 5 categorias de checks?",
            "answer": "Cost Optimization, Security, Fault Tolerance, Performance, Service Limits. Planos Basic/Developer recebem subset; Business/Enterprise recebem todos."
          }
        }
      ]
    },
    {
      "id": "a683d96f-e654-4f41-be8e-fddad3cf0304",
      "type": "callout",
      "position": 12,
      "data": {
        "variant": "success",
        "title": "",
        "content": "Take-aways: KMS (chaves) ≠ Secrets Manager (senhas/tokens) ≠ ACM (certificados TLS). GuardDuty (threat detection) ≠ Inspector (CVEs) ≠ Macie (PII em S3). Shield (DDoS L3/L4) ≠ WAF (L7 OWASP). CloudTrail (API audit) + Config (state drift) + Security Hub (dashboard). Organizations + Control Tower = governance multi-account. Artifact = compliance reports. Decore o \"qual serviço resolve X\" — é o padrão das questões."
      }
    }
  ]
}