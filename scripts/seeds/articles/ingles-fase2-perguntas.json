    {
      "id": "dd056ab1-52a7-4368-9486-4d80c55e7e79",
      "type": "section",
      "position": 2,
      "data": {
        "title": "Do / Does para o Present Simple"
      },
      "children": [
        {
          "id": "37acab01-6db6-4ca0-b43c-a81976ef7fe5",
          "type": "paragraph",
          "position": 0,
          "data": {
            "content": [
              {
                "text": " Para perguntas com verbos que não são To Be, usamos os auxiliares "
              },
              {
                "text": "do",
                "code": true
              },
              {
                "text": " e "
              },
              {
                "text": "does",
                "code": true
              },
              {
                "text": ". A regra de uso: "
              }
            ]
          }
        },
        {
          "id": "2ac6cfa3-b2b6-4ed0-8bb7-c9f91f76ae6a",
          "type": "comparison_table",
          "position": 1,
          "data": {
            "columns": [
              "Pronome",
              "Auxiliar",
              "Exemplo"
            ],
            "rows": [
              [
                "I",
                "Do",
                "Do I need to sign?"
              ],
              [
                "You",
                "Do",
                "Do you live here?"
              ],
              [
                "We",
                "Do",
                "Do we have a meeting?"
              ],
              [
                "They",
                "Do",
                "Do they speak English?"
              ],
              [
                "He",
                "Does",
                "Does he work here?"
              ],
              [
                "She",
                "Does",
                "Does she like coffee?"
              ],
              [
                "It",
                "Does",
                "Does it work?"
              ]
            ]
