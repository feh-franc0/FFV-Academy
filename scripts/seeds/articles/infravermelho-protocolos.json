                "desc": "identifica o aparelho (TV, AC, etc.)"
              },
              {
                "icon": "🅰️",
                "label": "~Address (8 bits)",
                "desc": "complemento, validação"
              },
              {
                "icon": "🅒",
                "label": "Command (8 bits)",
                "desc": "tecla pressionada"
              },
              {
                "icon": "🅒",
                "label": "~Command (8 bits)",
                "desc": "complemento, validação"
              },
              {
                "icon": "🛑",
                "label": "Final burst",
                "desc": "560µs — fecha o frame"
              }
            ]
          }
        },
        {
          "id": "7fec37a3-5756-4552-b799-658c62814402",
          "type": "key_value",
          "position": 1,
          "data": {
            "items": [
              {
                "k": "Portadora",
