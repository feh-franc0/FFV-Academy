        {
          "id": "cad539e2-4fe9-4ce5-86a2-b02e58e3ec9a",
          "type": "callout",
          "position": 1,
          "data": {
            "variant": "info",
            "title": "",
            "content": "Retry behavior por modelo: sync → caller decide (sem retry automático). Async → Lambda retry 2x com exponential backoff; depois DLQ/OnFailure. Event source mapping → depende do source (SQS reenfileira, Kinesis retry até expirar)."
          }
        }
      ]
    },
