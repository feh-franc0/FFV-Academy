        "title": "MVCC em 1 query"
      },
      "children": [
        {
          "id": "334c50c1-fab5-46a5-8c92-f6f3f6ef4acf",
          "type": "code_block",
          "position": 0,
          "data": {
            "language": "sql",
            "code": "-- Inspect xmin/xmax diretamente\nSELECT xmin, xmax, * FROM users WHERE id = 1;\n\n-- UPDATE cria NOVA versão\nBEGIN;\nUPDATE users SET email = 'new' WHERE id = 1;\n-- Row antiga: xmax = current_xact\n-- Row nova: xmin = current_xact\n-- Outras txs ainda veem antiga até COMMIT\n\n-- Dead tuples acumulam → vacuum periódico\nVACUUM ANALYZE users;"
          }
        }
      ]
    },
