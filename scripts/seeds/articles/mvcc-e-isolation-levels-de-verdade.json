        {
          "id": "0711b7db-33aa-4400-852b-553fd4e1e469",
          "type": "callout",
          "position": 1,
          "data": {
            "variant": "info",
            "title": "",
            "content": "*No PG, Read Uncommitted é tratado como Read Committed — dirty read NUNCA acontece. Em MySQL/SQL Server dirty read é real em RU."
          }
        }
      ]
    },
    {
      "id": "d830f4c0-50b1-4ad5-bf6d-55f0a3b47296",
      "type": "section",
      "position": 2,
      "data": {
        "title": "Quando usar cada level"
      },
      "children": [
        {
          "id": "51c55615-133b-4bb6-aebe-b713693b9ed3",
          "type": "list",
          "position": 0,
          "data": {
            "items": [
              "Read Committed (default): web CRUD — 95% dos casos.",
              "Repeatable Read: report que faz múltiplas queries e quer snapshot consistente (ex: dashboard).",
              "Serializable + retry: transações financeiras sensíveis onde consistência > throughput.",
              "SELECT FOR UPDATE: locking explícito em Read Committed pra evitar lost update."
            ],
            "ordered": false
          }
        }
      ]
    }
  ]
