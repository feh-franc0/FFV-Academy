        {
          "id": "84addc2f-b1c2-487b-95ee-ee304821558c",
          "type": "callout",
          "position": 23,
          "data": {
            "variant": "info",
            "title": "",
            "content": "Regra útil: se o benchmark de uma ferramenta não informa qual modelo, qual versão, quantos turnos, descarte o número. Comparar \"ferramenta A: 60%\" vs \"ferramenta B: 55%\" sem essas variáveis é comparar rankings de futebol de anos diferentes."
          }
        }
      ]
    },
    {
      "id": "10f57fcc-c413-45a7-853a-c3c5201f076d",
      "type": "section",
