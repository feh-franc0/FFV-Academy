        {
          "id": "cbe27c00-c95b-4c53-a409-698f9f7a5d19",
          "type": "callout",
          "position": 1,
          "data": {
            "variant": "info",
            "title": "",
            "content": "Decisão simples: precisa de rotation automática? Secrets Manager. Caso contrário, Parameter Store com SecureString é mais barato e suficiente para 90% dos casos."
          }
        },
        {
          "id": "31635a81-c275-4813-a425-bd3be03854ae",
          "type": "code_block",
          "position": 2,
          "data": {
            "language": "bash",
            "code": "# Secrets Manager — buscar segredo em app\naws secretsmanager get-secret-value --secret-id prod/db/credentials\n\n# Parameter Store — hierárquico\naws ssm get-parameters-by-path --path /prod/api/ --with-decryption --recursive"
          }
        }
      ]
    },
    {
      "id": "ba873b20-8a4c-4f9c-8192-451ea4462889",
      "type": "section",
      "position": 3,
      "data": {
        "title": "WAF — Web Application Firewall"
      },
      "children": [
        {
          "id": "a084a0a0-580e-4e0b-9003-a9899fe8731e",
          "type": "paragraph",
          "position": 0,
          "data": {
            "content": [
              {
                "text": " WAF roda na frente de CloudFront, ALB, API Gateway, AppSync ou App Runner. Inspeciona requests HTTP(S) e aplica regras. "
              }
            ]
          }
        }
      ]
    },
