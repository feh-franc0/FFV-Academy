    {
      "id": "27dd8dcf-510d-4e80-a83a-dde8192a2f46",
      "type": "section",
      "position": 6,
      "data": {
        "title": "Kinesis — streaming de dados"
      },
      "children": [
        {
          "id": "45c0fce7-c459-413d-8f88-a750f5f3f10f",
          "type": "comparison_table",
          "position": 0,
          "data": {
            "columns": [
              "Variante",
              "Função",
              "Caso de uso"
            ],
            "rows": [
              [
                "Kinesis Data Streams",
                "Stream ordenado por shard, retenção 24h–365d",
                "Real-time ingest, múltiplos consumers independentes"
              ],
              [
                "Kinesis Data Firehose",
                "Delivery managed para S3/Redshift/OpenSearch/Splunk",
                "ETL simples, sem custom processing"
              ],
              [
                "Kinesis Data Analytics",
                "SQL/Flink sobre streams",
                "Analytics em janela de tempo (tumbling/sliding)"
              ],
              [
