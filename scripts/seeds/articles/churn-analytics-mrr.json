    {
      "id": "ca822bc8-7d84-4fa7-83db-227c6e37d021",
      "type": "section",
      "position": 4,
      "data": {
        "title": "Cohort retention curves: a verdade sobre o produto"
      },
      "children": [
        {
          "id": "41afb648-a268-40ae-bb26-d6b353f5a4f8",
          "type": "paragraph",
          "position": 0,
          "data": {
            "content": [
              {
                "text": " Churn agregado mensal mente. Cohort retention curves não. O setup: "
              }
            ]
          }
        },
        {
          "id": "9f1a9e93-d7cd-4a93-b259-771917fad597",
          "type": "code_block",
          "position": 1,
          "data": {
            "language": "sql",
            "code": "-- Cohort retention em SQL puro (Postgres)\nWITH cohorts AS (\n  SELECT\n    user_id,\n    DATE_TRUNC('month', signup_date) AS cohort_month\n  FROM users\n),\nactivity AS (\n  SELECT\n    s.user_id,\n    c.cohort_month,\n    DATE_TRUNC('month', s.period_start) AS active_month\n  FROM subscriptions s\n  JOIN cohorts c USING (user_id)\n  WHERE s.status IN ('active', 'trialing')\n),\nretention AS (\n  SELECT\n    cohort_month,\n    active_month,\n    EXTRACT(MONTH FROM AGE(active_month, cohort_month)) AS months_since_signup,\n    COUNT(DISTINCT user_id) AS active_users\n  FROM activity\n  GROUP BY 1, 2, 3\n),\ncohort_size AS (\n  SELECT cohort_month, COUNT(DISTINCT user_id) AS total\n  FROM cohorts\n  GROUP BY 1\n)\nSELECT\n  r.cohort_month,\n  r.months_since_signup,\n  ROUND(100.0 * r.active_users / c.total, 1) AS retention_pct\nFROM retention r\nJOIN cohort_size c USING (cohort_month)\nORDER BY r.cohort_month, r.months_since_signup;"
          }
        },
        {
          "id": "0cd3cbd9-7e45-4195-9763-8276c71bc5cc",
          "type": "callout",
          "position": 2,
          "data": {
            "variant": "info",
            "title": "",
            "content": "PostHog, Mixpanel, Amplitude, ChartMogul, Baremetrics — todos têm cohort built-in. Para solo SaaS pequeno: PostHog free aguenta tudo. Para SaaS faturando: ChartMogul resolve."
          }
        }
      ]
    },
