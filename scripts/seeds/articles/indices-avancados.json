      "id": "d6fcc237-9f69-4e3d-a610-9835e7de4af7",
      "type": "section",
      "position": 1,
      "data": {
        "title": "Index tipos especiais"
      },
      "children": [
        {
          "id": "304ae88c-43f2-4a16-bbfb-3ea35557cdb9",
          "type": "code_block",
          "position": 0,
          "data": {
            "language": "sql",
            "code": "-- Partial index — só active users\nCREATE INDEX idx_users_active\nON users (email) WHERE deleted_at IS NULL;\n\n-- Expression index — lowercased email (case-insensitive search)\nCREATE INDEX idx_users_email_lower\nON users (LOWER(email));\n-- Query precisa usar MESMA expression:\nSELECT * FROM users WHERE LOWER(email) = 'a@b.co';\n\n-- Covering index — evita heap fetch\nCREATE INDEX idx_orders_user_covering\nON orders (user_id) INCLUDE (total, status);\n\n-- Composite index — prefix rule: (a, b, c) serve (a), (a,b), (a,b,c) mas NÃO (b) ou (c)\nCREATE INDEX idx_orders_uset ON orders (user_id, status, created_at);\n\n-- JSONB GIN\nCREATE INDEX idx_events_data ON events USING GIN (data);\nSELECT * FROM events WHERE data @> '{\"action\": \"login\"}';"
          }
        }
      ]
    },
    {
      "id": "ce40ed9f-2329-4ed0-980a-1201bcf5e7b2",
      "type": "section",
      "position": 2,
      "data": {
        "title": "Quando NÃO indexar"
      },
      "children": [
        {
          "id": "64b8868c-39a6-4826-bd81-dd14cfb19d85",
          "type": "list",
          "position": 0,
          "data": {
            "items": [
              "Tabela muito pequena (< 1k rows): Seq Scan > índice",
              "Coluna com baixa cardinalidade (ex: boolean sem partial)",
              "Coluna muito mutável (índice retarda writes)",
              "Em prod sem dor — índice adicional custa storage + writes."
            ],
            "ordered": false
          }
        },
        {
          "id": "a6ac4e6e-ece2-46aa-9329-21d3a84ed2cb",
          "type": "callout",
          "position": 1,
          "data": {
            "variant": "info",
            "title": "",
            "content": "Regra: meça com EXPLAIN ANALYZE ANTES e DEPOIS. Às vezes o índice criado não é usado pelo planner (estatísticas ruins, coluna low-cardinality). pg_stat_user_indexes mostra uso real."
          }
        }
      ]
    }
  ]
