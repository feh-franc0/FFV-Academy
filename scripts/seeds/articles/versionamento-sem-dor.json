      },
      "children": [
        {
          "id": "f9ae30fe-a42a-4419-ab44-57cfa403c489",
          "type": "code_block",
          "position": 0,
          "data": {
            "language": "http",
            "code": "HTTP/1.1 200 OK\nDeprecation: true\nSunset: Sat, 31 Dec 2026 23:59:59 GMT\nLink: </v2/users/123>; rel=\"successor-version\"\n\n{ \"id\": 123, \"name\": \"...\" }"
          }
        },
        {
          "id": "a87b5cda-bd57-49e2-aaa2-be8847c92768",
          "type": "paragraph",
          "position": 1,
          "data": {
            "content": [
              {
                "text": " RFC 8594 (Sunset) + RFC 9745 (Deprecation). Clientes bem comportados (SDKs gerados a partir de OpenAPI) alertam dev no build. Scanner simples em API gateway detecta clientes ainda usando v1 pra CS entrar em contato. "
              }
            ]
          }
        }
      ]
