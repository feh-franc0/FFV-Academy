    {
      "id": "bdfc3271-c02b-4cbf-9167-3f31f43398ca",
      "type": "section",
      "position": 3,
      "data": {
        "title": "Forma negativa: am not / isn't / aren't"
      },
      "children": [
        {
          "id": "927908c0-7ca6-4321-b9bd-0d49e3ea1432",
          "type": "paragraph",
          "position": 0,
          "data": {
            "content": [
              {
                "text": " Para negar com To Be, basta adicionar "
              },
              {
                "text": "not",
                "code": true
              },
              {
                "text": " após o verbo. Existem contrações para tornar a fala mais natural. "
              }
            ]
          }
        },
