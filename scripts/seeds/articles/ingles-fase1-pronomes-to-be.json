                "I'm not",
                "I'm not tired. (Não estou cansado.)"
              ],
              [
                "You",
                "are not",
                "aren't / you're not",
                "You aren't late. (Você não está atrasado.)"
              ],
              [
                "He",
                "is not",
                "isn't / he's not",
                "He isn't here. (Ele não está aqui.)"
