{
  "name": "ffv-academy-marketing",
  "version": "2.0.0",
  "private": true,
  "description": "Pipeline de video comercial FFV Academy (Playwright + Remotion) — 4 variantes (horizontal/vertical x phone/computer)",
  "scripts": {
    "record": "npx tsx scripts/record-beats.ts",
    "record-all": "npx tsx scripts/record-beats.ts --all",
    "preview": "npx remotion studio src/short/index.tsx",
    "render": "npx tsx scripts/render-shorts.ts",
    "render-all": "npx tsx scripts/render-shorts.ts --all",
    "extract-frames": "bash scripts/extract-frames-short.sh",
    "pipeline": "npm run record-all && npm run render-all"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "@remotion/renderer": "^4.0.512",
    "playwright": "^1.48.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
